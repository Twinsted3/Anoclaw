for dom in ['D1','D5','D9','D12']:
    f=f'benchmark/results/active_learning/al_qwen35_{dom}.json'
    out=json.load(open(f))
    print('\\n',dom,'keys',out.keys())
    print('summary', {k:out.get(k) for k in ['domain','k','fewshot_k','selection','auroc_passive','auroc_active','delta_auroc','auroc_error']})
    print('oracle n',len(out.get('oracle_items',[])),'active n',len(out.get('active',[])),'passive n',len(out.get('passive',[])))
    for label,arr in [('passive',out.get('passive',[])),('active',out.get('active',[]))]:
        y=[int(r['label_gt']) for r in arr]
