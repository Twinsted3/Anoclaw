import re, pathlib
labels=[]; refs=[]; cites=[]
for p in pathlib.Path('paper').rglob('*.tex'):
    txt=p.read_text(errors='ignore')
    for m in re.finditer(r'\\\\label\\{(["'^}]+)'"\\}', txt): labels.append((m.group(1),str(p),m.start()))
    for m in re.finditer(r'\\\\(?:[Cc]?ref|autoref)\\{(["'^}]+)'"\\}', txt):
        for x in m.group(1).split(','): refs.append((x.strip(),str(p),m.start()))
    for m in re.finditer(r'\\\\cite[t|p|alp|author|year]*\\{(["'^}]+)'"\\}', txt):
        for x in m.group(1).split(','): cites.append((x.strip(),str(p),m.start()))
labelset={x for x,_,_ in labels}
print('UNRESOLVED REFS')
for r,p,_ in sorted(refs):
    if r and r not in labelset: print(r,p)
# bib entries rough
bib=pathlib.Path('paper/references.bib').read_text(errors='ignore')
bibkeys=set(re.findall(r'@\\w+\\{\\s*(["'^,'"\\s]+)', bib))
print('\\nUNRESOLVED CITES')
for c,p,_ in sorted(cites):
    if c and c not in bibkeys: print(c,p)
from collections import Counter
print('\\nDUP LABELS')
for k,n in Counter(x for x,_,_ in labels).items():
    if n>1: print(k,n)
