/bin/bash -lc "python - <<'PY'
import json, numpy as np
from collections import defaultdict
from sklearn.metrics import roc_auc_score


def macro(items, get_score):
    by=defaultdict(list)
    for x in items:
        if x.get('label_gt') is not None:
            by[x['domain_code']].append(x)
    vals=[]
    for d,it in by.items():
        y=[i['label_gt'] for i in it]
        s=[get_score(i) for i in it]
        if len(set(y))>1:
            vals.append(roc_auc_score(y,s))
    return float(np.mean(vals))

direct={x['item_id']:x for x in json.load(open('benchmark/results/v6_direct_qwen3_test.json'))}
v65={x['item_id']:x for x in json.load(open('benchmark/results/v6_5_agent_qwen3_test.json'))}
items=[x for x in direct.values() if x['item_id'] in v65]
scores=np.array([v65[i['item_id']]['anomaly_score'] for i in items])
uniq=np.array(sorted(set(scores)))
# strict monotone remap by unique score, all outside [0.2,0.8]
# split unique values at median score value, not item median constant.
med=np.median(scores)
low=uniq[uniq<=med]
high=uniq[uniq>med]
map_ext={}
if len(low):
    vals=np.linspace(0.05,0.19,len(low))
    map_ext.update({float(k):float(v) for k,v in zip(low,vals)})
if len(high):
    vals=np.linspace(0.81,0.95,len(high))
    map_ext.update({float(k):float(v) for k,v in zip(high,vals)})

def v65_extreme_rank(i):
    return map_ext[float(v65[i['item_id']]['anomaly_score'])]

def v65_bin(i):
    return 0.95 if v65[i['item_id']]['anomaly_score'] > med else 0.05

def blend(fn):
    return lambda i: 0.5*direct[i['item_id']]['anomaly_score']+0.5*fn(i)

orig=lambda i:v65[i['item_id']]['anomaly_score']
directfn=lambda i:direct[i['item_id']]['anomaly_score']
for name,fn in [('Direct',directfn),('v6 orig',orig),('v6 median-bin',v65_bin),('v6 extreme-rank-preserve',v65_extreme_rank)]:
    vals=np.array([fn(i) for i in items])
    print(name, 'alone', macro(items,fn), 'ens', None if name=='Direct' else macro(items,blend(fn)), 'mid%', ((vals>=0.2)&(vals<=0.8)).mean()*100, 'unique', len(set(vals)))
print('orig ensemble', macro(items,blend(orig)))
# Compare affine/calibration variants for v6 preserving rank but compressing/expanding around 0.5
for a in [0.25,0.5,1.0,2.0,4.0,8.0]:
    def fn(i,a=a):
        x=orig(i)
        y=0.5+(x-0.5)*a
        return min(1,max(0,y))
    vals=np.array([fn(i) for i in items])
    print('affine',a,'alone',macro(items,fn),'ens',macro(items,blend(fn)),'mid%',((vals>=0.2)&(vals<=0.8)).mean()*100)
