/bin/bash -lc "nl -ba benchmark/scripts/mmad_eval.py | sed -n '1,150p'; nl -ba benchmark/scripts/mmad_eval_v9.py | sed -n '1,130p'; nl -ba benchmark/scripts/mmad_relabel.py | sed -n '1,180p'" in /hdd1/jiangxi/AD-Agent
 succeeded in 0ms:
     1	"""MMAD benchmark evaluator for AnomalyClaw on Qwen3.5-VL.
     2	
     3	MMAD is a 39,670-question industrial anomaly detection MCQ benchmark (Jiang
     4	et al., ICLR 2025). We evaluate on the "Anomaly Detection" subset
     5	(binary Yes/No per image; 8,297 images covering MVTec-AD, MVTec-LOCO,
     6	VisA, GoodsAD) by running Direct VLM and the v6 agent on each query,
     7	then mapping the anomaly score to A/B:
     8	
     9	    score > 0.5  ->  A ("Yes, there's a defect")
    10	    score <= 0.5 ->  B ("No defect")
    11	
    12	Per image we use the first 4 normal `random_templates` from mmad.json as
    13	references (consistent with MMAD protocol's few_shot=4 normal setup).
    14	
    15	Usage:
    16	    python benchmark/scripts/mmad_eval.py \
    17	      --mmad_root MMAD/dataset/MMAD \
    18	      --sample 1000 \
    19	      --output benchmark/results/mmad_anomaly_qwen3.json \
    20	      --max_workers 9 --max_turns 5
    21	"""
    22	from __future__ import annotations
    23	import argparse
    24	import json
    25	import os
    26	import random
    27	import sys
    28	import time
    29	from collections import Counter, defaultdict
    30	from concurrent.futures import ThreadPoolExecutor, as_completed
    31	from pathlib import Path
    32	
    33	sys.path.insert(0, str(Path(__file__).parent))
    34	
    35	from infer import (  # noqa: E402
    36	    call_llm, extract_json, get_client, get_model_name,
    37	    img_msg, load_and_encode, text_msg,
    38	)
    39	import agent_v6 as v6_mod  # noqa: E402
    40	
    41	
    42	def iter_mmad_ad_items(mmad_root: str, only_ad: bool = True):
    43	    """Yield one item per image × AD-question from mmad.json.
    44	
    45	    Each yielded dict:
    46	        item_id (str unique),
    47	        image (str absolute path),
    48	        refs (list of str absolute paths; first 4 random_templates),
    49	        class_name (e.g. "bottle"),
    50	        dataset (e.g. "DS-MVTec"),
    51	        label_gt (0 if 'good' in path, 1 otherwise),
    52	        correct_answer (str A|B|C|D),
    53	        question_type (str),
    54	        question (str),
    55	        options (dict).
    56	    """
    57	    mmad_json = json.load(open(os.path.join(mmad_root, "mmad.json")))
    58	    for key, v in mmad_json.items():
    59	        parts = key.split("/")
    60	        dataset = parts[0]
    61	        class_name = parts[1] if len(parts) >= 2 else "unknown"
    62	        image_abs = os.path.join(mmad_root, key)
    63	        refs = []
    64	        for t in (v.get("random_templates") or [])[:4]:
    65	            refs.append(os.path.join(mmad_root, t))
    66	        # Yield each QA turn
    67	        # Label from immediate parent folder (not full key — "good" is inside
    68	        # "GoodsAD", which would otherwise flip all GoodsAD items to label=0).
    69	        _parts = key.split("/")
    70	        _parent = _parts[-2].lower() if len(_parts) >= 2 else ""
    71	        path_lab = 0 if _parent in {"good", "normal", "ok"} else 1
    72	        for idx, qa in enumerate(v.get("conversation", [])):
    73	            if only_ad and qa.get("type") != "Anomaly Detection":
    74	                continue
    75	            # Prefer options[Answer] text for AD; fall back to path.
    76	            label_gt = path_lab
    77	            if qa.get("type") == "Anomaly Detection":
    78	                ans = qa.get("Answer")
    79	                opts = qa.get("Options") or {}
    80	                if ans in opts:
    81	                    _t = str(opts[ans]).lower()
    82	                    if any(k in _t for k in ("yes", "defect", "there is",
    83	                                             "anomal")):
    84	                        label_gt = 1
    85	                    elif any(k in _t for k in ("no", "normal")):
    86	                        label_gt = 0
    87	            yield {
    88	                "item_id": f"{key}#q{idx}",
    89	                "image": image_abs,
    90	                "refs": refs,
    91	                "class_name": class_name,
    92	                "dataset": dataset,
    93	                "label_gt": label_gt,
    94	                "correct_answer": qa.get("Answer"),
    95	                "question_type": qa.get("type"),
    96	                "question": qa.get("Question"),
    97	                "options": qa.get("Options", {}),
    98	                "raw_key": key,
    99	            }
   100	
   101	
   102	def stratified_sample(items, n, seed=42):
   103	    """Sample n items stratified by class_name (roughly proportional)."""
   104	    rng = random.Random(seed)
   105	    by_class: dict[str, list] = defaultdict(list)
   106	    for x in items:
   107	        by_class[f"{x['dataset']}/{x['class_name']}"].append(x)
   108	    total = sum(len(v) for v in by_class.values())
   109	    # Proportional alloc with min 5 per class
   110	    alloc = {k: max(5, int(n * len(v) / total)) for k, v in by_class.items()}
   111	    total_alloc = sum(alloc.values())
   112	    if total_alloc > n:
   113	        # Scale down proportionally
   114	        scale = n / total_alloc
   115	        alloc = {k: max(3, int(v * scale)) for k, v in alloc.items()}
   116	    sample = []
   117	    for k, cap in alloc.items():
   118	        pool = by_class[k]
   119	        rng.shuffle(pool)
   120	        sample.extend(pool[:cap])
   121	    rng.shuffle(sample)
   122	    return sample
   123	
   124	
   125	# --- Direct VLM scoring -------------------------------------------------
   126	
   127	DIRECT_PROMPT = (
   128	    "You are a visual anomaly detection expert. I will show you four NORMAL "
   129	    "reference images of the same product, followed by one QUERY image. "
   130	    "Decide whether the query shows a manufacturing defect, damage, or "
   131	    "abnormal appearance.\n\n"
   132	    "Return ONLY a JSON object: {\"thought\": \"<one sentence>\", "
   133	    "\"score\": <float 0..1>, \"rationale\": \"<one sentence>\"}. "
   134	    "score close to 0 = clearly normal, score close to 1 = clearly anomalous, "
   135	    "0.5 = genuinely uncertain."
   136	)
   137	
   138	
   139	def direct_score(client, model, image_path: str, ref_paths: list[str]) -> dict:
   140	    parts = [text_msg("NORMAL REFERENCE IMAGES:")]
   141	    for rp in ref_paths[:4]:
   142	        if os.path.exists(rp):
   143	            parts.append(img_msg(load_and_encode(rp)))
   144	    parts.append(text_msg("QUERY IMAGE:"))
   145	    parts.append(img_msg(load_and_encode(image_path)))
   146	    messages = [
   147	        {"role": "system", "content": DIRECT_PROMPT},
   148	        {"role": "user", "content": parts},
   149	    ]
   150	    try:
     1	"""MMAD full-type evaluator for v9 unified agent.
     2	
     3	Extends mmad_eval.py to all 9 MMAD question types (not just AD).
     4	
     5	For each (image, question) pair:
     6	  - Agent v9 runs with (image, refs, question, options) → mcq_answer or score
     7	  - Direct VLM: MCQ-aware prompt → per-option softmax → argmax
     8	  - AD only: ensemble via 0.5*s_direct + 0.5*s_agent → threshold→letter.
     9	
    10	Output JSON per item: {type, letter_gt, direct_letter, agent_letter,
    11	  ensemble_letter(AD only), scores, ...}.
    12	
    13	Usage:
    14	  python benchmark/scripts/mmad_eval_v9.py \
    15	    --mmad_root MMAD/dataset/MMAD \
    16	    --sample 1000 --output benchmark/results/mmad_v9_dev989.json \
    17	    --max_workers 9 --max_turns 5 \
    18	    --backend qwen3
    19	"""
    20	from __future__ import annotations
    21	import argparse
    22	import json
    23	import os
    24	import random
    25	import sys
    26	import time
    27	from collections import defaultdict
    28	from concurrent.futures import ThreadPoolExecutor, as_completed
    29	from pathlib import Path
    30	
    31	sys.path.insert(0, str(Path(__file__).parent))
    32	
    33	from infer import (  # noqa: E402
    34	    call_llm, extract_json, get_client, get_model_name,
    35	    img_msg, load_and_encode, text_msg,
    36	)
    37	import agent_v9 as v9_mod  # noqa: E402
    38	
    39	
    40	# -------------------------- Data loading --------------------------
    41	
    42	QTYPES_ALL = (
    43	    "Anomaly Detection",
    44	    "Defect Classification",
    45	    "Defect Localization",
    46	    "Defect Description",
    47	    "Defect Analysis",
    48	    "Object Classification",
    49	    "Object Analysis",
    50	    "Object Structure",
    51	    "Object Details",
    52	)
    53	
    54	
    55	def _path_label(key: str) -> int:
    56	    """Derive anomaly label from MMAD path.
    57	
    58	    Check only the immediate defect-type folder (parent of basename),
    59	    never substring match the whole key — 'good' appears inside
    60	    'GoodsAD' and would otherwise flip all GoodsAD items to label=0.
    61	    """
    62	    parts = key.split("/")
    63	    if len(parts) < 2:
    64	        return 1
    65	    parent = parts[-2].lower()
    66	    if parent in {"good", "normal", "ok"}:
    67	        return 0
    68	    return 1
    69	
    70	
    71	def _ad_label_from_options(qa: dict) -> int | None:
    72	    """Preferred label for AD questions: use options[Answer] text."""
    73	    ans = qa.get("Answer")
    74	    opts = qa.get("Options") or {}
    75	    if ans not in opts:
    76	        return None
    77	    txt = str(opts[ans]).lower()
    78	    if any(k in txt for k in ("yes", "defect", "there is", "anomal")):
    79	        return 1
    80	    if any(k in txt for k in ("no", "normal")):
    81	        return 0
    82	    return None
    83	
    84	
    85	def iter_mmad_items(mmad_root: str, qtypes=QTYPES_ALL):
    86	    mmad_json = json.load(open(os.path.join(mmad_root, "mmad.json")))
    87	    for key, v in mmad_json.items():
    88	        parts = key.split("/")
    89	        dataset = parts[0]
    90	        class_name = parts[1] if len(parts) >= 2 else "unknown"
    91	        image_abs = os.path.join(mmad_root, key)
    92	        refs = []
    93	        for t in (v.get("random_templates") or [])[:4]:
    94	            refs.append(os.path.join(mmad_root, t))
    95	        path_lab = _path_label(key)
    96	        for idx, qa in enumerate(v.get("conversation", [])):
    97	            qt = qa.get("type")
    98	            if qt not in qtypes:
    99	                continue
   100	            # AD: use options-derived label; others: fall back to path label
   101	            if qt == "Anomaly Detection":
   102	                ad_lab = _ad_label_from_options(qa)
   103	                label_gt = ad_lab if ad_lab is not None else path_lab
   104	            else:
   105	                label_gt = path_lab
   106	            yield {
   107	                "item_id": f"{key}#q{idx}",
   108	                "image": image_abs,
   109	                "refs": refs,
   110	                "class_name": class_name,
   111	                "dataset": dataset,
   112	                "label_gt": label_gt,
   113	                "correct_answer": qa.get("Answer"),
   114	                "question_type": qt,
   115	                "question": qa.get("Question"),
   116	                "options": qa.get("Options", {}) or {},
   117	                "raw_key": key,
   118	            }
   119	
   120	
   121	def stratified_sample_images(mmad_root, n_images, seed=42):
   122	    """Sample n_images images stratified by dataset/class, then expand to
   123	    all questions on those images."""
   124	    by_img = defaultdict(list)
   125	    for item in iter_mmad_items(mmad_root):
   126	        by_img[item["raw_key"]].append(item)
   127	    by_class = defaultdict(list)
   128	    for k, v in by_img.items():
   129	        cls = f"{v[0]['dataset']}/{v[0]['class_name']}"
   130	        by_class[cls].append(k)
     1	"""Post-process mmad_eval_v9 JSON output to correct label_gt.
     2	
     3	Original bug: `'good' in key.lower()` flipped all GoodsAD items to label=0
     4	because "good" is a substring of "GoodsAD". This rewrites label_gt using
     5	the new path-parent + options[Answer] logic.
     6	
     7	Usage:
     8	  python benchmark/scripts/mmad_relabel.py input.json [--inplace]
     9	"""
    10	from __future__ import annotations
    11	import argparse
    12	import json
    13	import sys
    14	
    15	
    16	def path_label(key: str) -> int:
    17	    parts = key.split("/")
    18	    if len(parts) < 2:
    19	        return 1
    20	    parent = parts[-2].lower()
    21	    return 0 if parent in {"good", "normal", "ok"} else 1
    22	
    23	
    24	def ad_label_from_options(ans, opts) -> int | None:
    25	    if not opts or ans not in opts:
    26	        return None
    27	    txt = str(opts[ans]).lower()
    28	    if any(k in txt for k in ("yes", "defect", "there is", "anomal")):
    29	        return 1
    30	    if any(k in txt for k in ("no", "normal")):
    31	        return 0
    32	    return None
    33	
    34	
    35	def main():
    36	    ap = argparse.ArgumentParser()
    37	    ap.add_argument("input")
    38	    ap.add_argument("--inplace", action="store_true")
    39	    ap.add_argument("--out", default=None)
    40	    args = ap.parse_args()
    41	
    42	    data = json.load(open(args.input))
    43	    flipped = 0
    44	    preserved = 0
    45	    for r in data:
    46	        key = r.get("image") or r.get("item_id", "")
    47	        # "image" in v9 output = raw_key (relative). Strip any '#qN' suffix.
    48	        if "#" in key:
    49	            key = key.split("#", 1)[0]
    50	        path_lab = path_label(key)
    51	        if r.get("question_type") == "Anomaly Detection":
    52	            ad_lab = ad_label_from_options(r.get("correct_answer"),
    53	                                           r.get("options") or {})
    54	            new_lab = ad_lab if ad_lab is not None else path_lab
    55	        else:
    56	            new_lab = path_lab
    57	        old_lab = r.get("label_gt")
    58	        if old_lab is not None and old_lab != new_lab:
    59	            flipped += 1
    60	            r["label_gt_original"] = old_lab
    61	        else:
    62	            preserved += 1
    63	        r["label_gt"] = new_lab
    64	
    65	    out_path = args.input if args.inplace else (args.out or
    66	                                                args.input.replace(".json",
    67	                                                                   "_relabeled.json"))
    68	    with open(out_path, "w") as f:
    69	        json.dump(data, f)
    70	    print(f"Input:    {args.input} ({len(data)} items)")
    71	    print(f"Output:   {out_path}")
    72	    print(f"Flipped:  {flipped} items")
    73	    print(f"Preserved:{preserved} items")
    74	
    75	
    76	if __name__ == "__main__":
    77	    main()

