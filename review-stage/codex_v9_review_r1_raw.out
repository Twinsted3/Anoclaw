    43	    "Anomaly Detection",
    44	    "Defect Classification",
    45	    "Defect Localization",
    46	    "Defect Description",
    47	    "Defect Analysis",
    48	    "Object Classification",
    49	    "Object Analysis",
    50	    "Object Structure",
    51	    "Object Details",
    52	)
    53	
    54	
    55	def iter_mmad_items(mmad_root: str, qtypes=QTYPES_ALL):
    56	    mmad_json = json.load(open(os.path.join(mmad_root, "mmad.json")))
    57	    for key, v in mmad_json.items():
    58	        parts = key.split("/")
    59	        dataset = parts[0]
    60	        class_name = parts[1] if len(parts) >= 2 else "unknown"
    61	        image_abs = os.path.join(mmad_root, key)
    62	        refs = []
    63	        for t in (v.get("random_templates") or [])[:4]:
    64	            refs.append(os.path.join(mmad_root, t))
    65	        for idx, qa in enumerate(v.get("conversation", [])):
    66	            qt = qa.get("type")
    67	            if qt not in qtypes:
    68	                continue
    69	            label_gt = 0 if ("good" in key.lower() or "normal" in key.lower()) \
    70	                else 1
    71	            yield {
    72	                "item_id": f"{key}#q{idx}",
    73	                "image": image_abs,
    74	                "refs": refs,
    75	                "class_name": class_name,
    76	                "dataset": dataset,
    77	                "label_gt": label_gt,
    78	                "correct_answer": qa.get("Answer"),
    79	                "question_type": qt,
    80	                "question": qa.get("Question"),
    81	                "options": qa.get("Options", {}) or {},
    82	                "raw_key": key,
    83	            }
    84	
    85	
    86	def stratified_sample_images(mmad_root, n_images, seed=42):
    87	    """Sample n_images images stratified by dataset/class, then expand to
    88	    all questions on those images."""
    89	    by_img = defaultdict(list)
    90	    for item in iter_mmad_items(mmad_root):
    91	        by_img[item["raw_key"]].append(item)
    92	    by_class = defaultdict(list)
    93	    for k, v in by_img.items():
    94	        cls = f"{v[0]['dataset']}/{v[0]['class_name']}"
    95	        by_class[cls].append(k)
    96	    rng = random.Random(seed)
    97	    total_imgs = sum(len(v) for v in by_class.values())
    98	    n_classes = len(by_class)
    99	    # Scale floor with sample size. For very small n (sanity), allow 1 per class.
   100	    floor = 1 if n_images < n_classes * 3 else (3 if n_images < n_classes * 8
   101	                                                else 5)
   102	    alloc = {k: max(floor, int(n_images * len(v) / total_imgs))
   103	             for k, v in by_class.items()}
   104	    total_alloc = sum(alloc.values())
   105	    if total_alloc > n_images:
   106	        scale = n_images / total_alloc
   107	        alloc = {k: max(1, int(v * scale)) for k, v in alloc.items()}
   108	    keys = []
   109	    for cls, cap in alloc.items():
   110	        pool = by_class[cls]
   111	        rng.shuffle(pool)
   112	        keys.extend(pool[:cap])
   113	    rng.shuffle(keys)
   114	    # Hard cap at n_images
   115	    keys = keys[:n_images]
   116	    # Expand to all questions on selected images
   117	    all_items = []
   118	    for k in keys:
   119	        all_items.extend(by_img[k])
   120	    return all_items
   121	
   122	
   123	# -------------------------- Direct VLM MCQ baseline --------------------------
   124	
   125	DIRECT_AD_PROMPT = (
   126	    "You are a visual anomaly detection expert. I will show you NORMAL "
   127	    "reference images followed by a QUERY image. Decide whether the query "
   128	    "shows a defect, damage, or abnormal appearance.\n\n"
   129	    "Return ONLY JSON: {\"thought\": \"<one sentence>\", \"score\": "
   130	    "<float 0..1>, \"rationale\": \"<one sentence>\"}. "
   131	    "score > 0.5 = anomalous."
   132	)
   133	
   134	DIRECT_MCQ_PROMPT = (
   135	    "You are an industrial-inspection visual expert. I will show you NORMAL "
   136	    "reference images followed by a QUERY image, then ask a multiple-choice "
   137	    "question. Read the question and options carefully and choose the single "
   138	    "best letter. Ground your answer in what you see.\n\n"
   139	    "Return ONLY JSON: {\"thought\": \"<one sentence>\", \"answer\": "
   140	    "\"A|B|C|D\", \"option_scores\": {\"A\":<float 0..1>, \"B\":<float 0..1>,"
   141	    " \"C\":<float 0..1>, \"D\":<float 0..1>}, "
   142	    "\"rationale\": \"<one sentence>\"}."
   143	)
   144	
   145	
   146	def direct_ad_score(client, model, image_path, ref_paths):
   147	    parts = [text_msg("NORMAL REFERENCE IMAGES:")]
   148	    for rp in ref_paths[:4]:
   149	        if os.path.exists(rp):
   150	            parts.append(img_msg(load_and_encode(rp)))
   151	    parts.append(text_msg("QUERY IMAGE:"))
   152	    parts.append(img_msg(load_and_encode(image_path)))
   153	    msgs = [{"role": "system", "content": DIRECT_AD_PROMPT},
   154	            {"role": "user", "content": parts}]
   155	    try:
   156	        text, _, _ = call_llm(client, model, msgs, max_tokens=180,
   157	                              temperature=0.0)
   158	    except Exception as e:
   159	        return {"score": 0.5, "error": f"call: {e}"}
   160	    parsed = extract_json(text)
   161	    if not isinstance(parsed, dict) or "score" not in parsed:
   162	        return {"score": 0.5, "error": "parse"}
   163	    try:
   164	        s = max(0.0, min(1.0, float(parsed["score"])))
   165	    except (TypeError, ValueError):
   166	        return {"score": 0.5, "error": "score_nan"}
   167	    return {"score": s, "rationale": str(parsed.get("rationale", ""))[:200]}
   168	
   169	
   170	def direct_mcq_answer(client, model, image_path, ref_paths, question,
   171	                      options):
   172	    parts = [text_msg("NORMAL REFERENCE IMAGES:")]
   173	    for rp in ref_paths[:4]:
   174	        if os.path.exists(rp):
   175	            parts.append(img_msg(load_and_encode(rp)))
   176	    parts.append(text_msg("QUERY IMAGE:"))
   177	    parts.append(img_msg(load_and_encode(image_path)))
   178	    opts_lines = "\n".join(f"  {k}: {v}" for k, v in options.items())
   179	    parts.append(text_msg(f"QUESTION: {question}\nOPTIONS:\n{opts_lines}"))
   180	    msgs = [{"role": "system", "content": DIRECT_MCQ_PROMPT},
   181	            {"role": "user", "content": parts}]
   182	    try:
   183	        text, _, _ = call_llm(client, model, msgs, max_tokens=220,
   184	                              temperature=0.0)
   185	    except Exception as e:
   186	        return {"answer": None, "error": f"call: {e}"}
   187	    parsed = extract_json(text)
   188	    if not isinstance(parsed, dict):
   189	        return {"answer": None, "error": "parse"}
   190	    ans = parsed.get("answer")
   191	    if ans not in ("A", "B", "C", "D"):
   192	        # try option_scores argmax
   193	        opt = parsed.get("option_scores") or {}
   194	        if opt:
   195	            try:
   196	                ans = max(opt.items(), key=lambda kv: float(kv[1]))[0]
   197	            except Exception:
   198	                ans = None
   199	    return {"answer": ans if ans in ("A", "B", "C", "D") else None,
   200	            "option_scores": parsed.get("option_scores"),
   201	            "rationale": str(parsed.get("rationale", ""))[:200]}
   202	
   203	
   204	# -------------------------- Agent wrapper --------------------------
   205	
   206	def v9_agent_run(client, model, item, split, max_turns):
   207	    """Run v9 agent on one MMAD item."""
   208	    agent_item = {
   209	        "item_id": item["item_id"],
   210	        "query_path": item["image"],
   211	        "ref_paths": item["refs"],
   212	        "domain_code": item["class_name"],
   213	    }
   214	    try:
   215	        r = v9_mod.run_v9_item(client, model, agent_item, split, max_turns,
   216	                               question=item["question"],
   217	                               options=item["options"])
   218	        return {
   219	            "score": r.score,
   220	            "mcq_answer": r.mcq_answer,
   221	            "free_text": r.free_text,
   222	            "option_scores": r.option_scores,
   223	            "mode": r.mode,
   224	            "rationale": (r.rationale or "")[:200],
   225	            "n_turns": r.n_turns, "tools_used": r.tools_used,
   226	            "error": r.error,
   227	        }
   228	    except Exception as e:
   229	        return {"score": 0.5, "mcq_answer": None, "error":
   230	                f"{type(e).__name__}: {e}"}
   231	
   232	
   233	# -------------------------- MCQ letter utilities --------------------------
   234	
   235	def ad_score_to_letter(score, options):
   236	    """Map AD score to Yes/No letter. Yes-letter = option containing
   237	    'yes|defect|there is|anomal'."""
   238	    yes_letter = None
   239	    no_letter = None
   240	    for letter, txt in options.items():
   241	        t = str(txt).lower()
   242	        if any(k in t for k in ("yes", "defect", "there is", "anomal")):
   243	            yes_letter = letter
   244	        elif any(k in t for k in ("no ", "no,", "no defect", "not ",
   245	                                  "normal")):
   246	            no_letter = letter
   247	    yes_letter = yes_letter or "A"
   248	    no_letter = no_letter or "B"
   249	    return yes_letter if score > 0.5 else no_letter
   250	
   251	
   252	# -------------------------- Main loop --------------------------
   253	
   254	def main():
   255	    ap = argparse.ArgumentParser()
   256	    ap.add_argument("--mmad_root", default="MMAD/dataset/MMAD")
   257	    ap.add_argument("--output", required=True)
   258	    ap.add_argument("--sample", type=int, default=1000,
   259	                    help="Sample size in IMAGES; expanded to all questions "
   260	                         "on those images. 0 = all images.")
   261	    ap.add_argument("--only_types", default=None,
   262	                    help="Comma-separated question types to keep.")
   263	    ap.add_argument("--backend", default="qwen3")
   264	    ap.add_argument("--max_workers", type=int, default=9)
   265	    ap.add_argument("--max_turns", type=int, default=5)
   266	    ap.add_argument("--seed", type=int, default=42)
   267	    ap.add_argument("--resume", action="store_true")
   268	    ap.add_argument("--mode", choices=["agent", "direct", "both"],
   269	                    default="both")
   270	    args = ap.parse_args()
   271	
   272	    if args.sample and args.sample > 0:
   273	        print(f"[mmad_v9] stratified sampling {args.sample} images",
   274	              flush=True)
   275	        items = stratified_sample_images(args.mmad_root, args.sample,
   276	                                         seed=args.seed)
   277	    else:
   278	        items = list(iter_mmad_items(args.mmad_root))
   279	    if args.only_types:
   280	        keep = set(t.strip() for t in args.only_types.split(","))
   281	        items = [x for x in items if x["question_type"] in keep]
   282	    print(f"[mmad_v9] {len(items)} QA items "
   283	          f"across {len({i['class_name'] for i in items})} classes",
   284	          flush=True)
   285	
   286	    # Resume
   287	    prev: list = []
   288	    done_ids: set = set()
   289	    if args.resume and os.path.exists(args.output):
   290	        prev = json.load(open(args.output))
   291	        done_ids = {r["item_id"] for r in prev if not r.get("fatal_error")}
   292	        items = [x for x in items if x["item_id"] not in done_ids]
   293	        print(f"[resume] {len(done_ids)} done; {len(items)} remaining",
   294	              flush=True)
   295	
   296	    client = get_client(args.backend)
   297	    model = get_model_name(args.backend)
   298	    t0 = time.time()
   299	
   300	    def _run(x):
   301	        out = {
   302	            "item_id": x["item_id"], "image": x["raw_key"],
   303	            "correct_answer": x["correct_answer"],
   304	            "question_type": x["question_type"],
   305	            "question": x["question"], "options": x["options"],
   306	            "class_name": x["class_name"], "dataset": x["dataset"],
   307	            "label_gt": x["label_gt"],
   308	        }
   309	        is_ad = (x["question_type"] == "Anomaly Detection")
   310	        # Direct
   311	        if args.mode in ("direct", "both"):
   312	            if is_ad:
   313	                dr = direct_ad_score(client, model, x["image"], x["refs"])
   314	                out["direct_score"] = dr.get("score")
   315	                out["direct_rationale"] = dr.get("rationale", "")
   316	                out["direct_answer"] = ad_score_to_letter(
   317	                    dr.get("score", 0.5), x["options"])
   318	                if dr.get("error"):
   319	                    out["direct_error"] = dr["error"]
   320	            else:
   321	                dm = direct_mcq_answer(client, model, x["image"], x["refs"],
   322	                                       x["question"], x["options"])
   323	                out["direct_answer"] = dm.get("answer")
   324	                out["direct_option_scores"] = dm.get("option_scores")
   325	                out["direct_rationale"] = dm.get("rationale", "")
   326	                if dm.get("error"):
   327	                    out["direct_error"] = dm["error"]
   328	        # Agent
   329	        if args.mode in ("agent", "both"):
   330	            ag = v9_agent_run(client, model, x, "test", args.max_turns)
   331	            out["agent_score"] = ag.get("score")
   332	            out["agent_option_scores"] = ag.get("option_scores")
   333	            out["agent_mode"] = ag.get("mode")
   334	            out["agent_n_turns"] = ag.get("n_turns")
   335	            out["agent_tools_used"] = ag.get("tools_used")
   336	            out["agent_rationale"] = ag.get("rationale", "")
   337	            if is_ad:
   338	                out["agent_answer"] = ad_score_to_letter(
   339	                    ag.get("score", 0.5), x["options"])
   340	            else:
   341	                out["agent_answer"] = ag.get("mcq_answer")
   342	            if ag.get("error"):
   343	                out["agent_error"] = ag["error"]
   344	        # Ensemble (AD only)
   345	        if args.mode == "both" and is_ad:
   346	            if (out.get("direct_score") is not None
   347	                    and out.get("agent_score") is not None):
   348	                ens = 0.5 * out["direct_score"] + 0.5 * out["agent_score"]
   349	                out["ensemble_score"] = ens
   350	                out["ensemble_answer"] = ad_score_to_letter(
   351	                    ens, x["options"])
   352	        return out
   353	
   354	    Path(args.output).parent.mkdir(parents=True, exist_ok=True)
   355	    results = list(prev)
   356	    with ThreadPoolExecutor(max_workers=args.max_workers) as ex:
   357	        futs = [ex.submit(_run, x) for x in items]
   358	        for i, f in enumerate(as_completed(futs)):
   359	            try:
   360	                results.append(f.result())
   361	            except Exception as e:
   362	                print(f"[err] worker: {type(e).__name__}: {e}", flush=True)
   363	            if (i + 1) % 10 == 0:
   364	                with open(args.output, "w") as ff:
   365	                    json.dump(results, ff)
   366	                dt = time.time() - t0
   367	                rate = (i + 1) / dt if dt > 0 else 0.0
   368	                eta = (len(items) - (i + 1)) / rate if rate > 0 else 0
   369	                print(f"[{i+1}/{len(items)}] t={dt:.1f}s "
   370	                      f"rate={rate:.2f}/s eta={eta:.0f}s", flush=True)
   371	
   372	    with open(args.output, "w") as f:
   373	        json.dump(results, f)
   374	    print(f"Wrote {len(results)} → {args.output}")
   375	
   376	    # Accuracy report by type
   377	    print("\n=== Per-type MCQ accuracy ===", flush=True)
   378	    for qt in QTYPES_ALL:
   379	        subset = [r for r in results if r.get("question_type") == qt]
   380	        if not subset:
   381	            continue
   382	        for field in ("direct_answer", "agent_answer", "ensemble_answer"):
   383	            correct = sum(1 for r in subset if r.get(field)
   384	                          and r.get(field) == r.get("correct_answer"))
   385	            total = sum(1 for r in subset if r.get(field))
   386	            if total:
   387	                print(f"  {qt:25s} {field:16s} {correct}/{total} = "
   388	                      f"{100*correct/total:5.2f}%")
   389	
   390	
   391	if __name__ == "__main__":
   392	    main()

