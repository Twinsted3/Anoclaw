     1	"""Verbalized Self-Evolution (§5 of paper).
     2	
     3	Three-regime learning ladder over CrossDomainVAD-11:
     4	
     5	  Passive v9       - training-free baseline (no rulebook); see agent_v9.
     6	  L1  ref-only     - self-supervised; rulebook reflected from NORMAL
     7	                     reference images only; zero oracle.
     8	  L2  active       - semi-supervised; run passive v9 on dev, pick K=10
     9	                     lowest-confidence items, reveal their labels from
    10	                     the manifest, reflect into corrective rules.
    11	  L1+L2 stacked    - concatenated rulebook (with dedup); oracle budget
    12	                     is still K (L2 budget only).
    13	
    14	Rulebook granularity: per-class for multi-class domains (D1,D2,D3,D4,
    15	D5,D6), per-domain for single-class domains (D7..D12). The lookup key
    16	is (domain_code, category) read from the manifest.
    17	
    18	All test items are STRICTLY held out of the rulebook-construction
    19	pipeline.  L2 only reveals labels for items whose split=='dev'.
    20	
    21	Usage:
    22	
    23	  # Stage 1: build L1 rulebook for one domain (0 oracle)
    24	  python verbalized_learning.py build-l1 \
    25	      --manifest benchmark/manifests_v2/D1_industrial_manifest.json \
    26	      --out      benchmark/results/verbalized/D1_l1.json \
    27	      --n_refs   8 --seed 0
    28	
    29	  # Stage 2: build L2 corrective rules (K=10 oracle)
    30	  python verbalized_learning.py build-l2 \
    31	      --manifest benchmark/manifests_v2/D1_industrial_manifest.json \
    32	      --passive_dev benchmark/results/verbalized/D1_passive_dev.json \
    33	      --l1       benchmark/results/verbalized/D1_l1.json \
    34	      --out      benchmark/results/verbalized/D1_l2.json \
    35	      --k 10
    36	
    37	  # Stage 3: evaluate on test with a rulebook
    38	  python verbalized_learning.py eval-test \
    39	      --manifest benchmark/manifests_v2/D1_industrial_manifest.json \
    40	      --rulebook benchmark/results/verbalized/D1_l1l2.json \
    41	      --out      benchmark/results/verbalized/D1_eval_l1l2.json
    42	"""
    43	from __future__ import annotations
    44	import argparse
    45	import json
    46	import os
    47	import random
    48	import sys
    49	import time
    50	from concurrent.futures import ThreadPoolExecutor, as_completed
    51	from pathlib import Path
    52	
    53	sys.path.insert(0, str(Path(__file__).parent))
    54	
    55	import agent_v9 as v9_mod  # noqa: E402
    56	from infer import (  # noqa: E402
    57	    call_llm, extract_json, get_client, get_model_name,
    58	    img_msg, load_and_encode, text_msg,
    59	)
    60	
    61	
    62	DOMAIN_FILES = {
    63	    "D1": "D1_industrial_manifest.json",
    64	    "D2": "D2_retail_manifest.json",
    65	    "D3": "D3_complex_industrial_manifest.json",
    66	    "D4": "D4_infrastructure_manifest.json",
    67	    "D5": "D5_logical_manifest.json",
    68	    "D6": "D6_industrial_3d_manifest.json",
    69	    "D7": "D7_remote_sensing_manifest.json",
    70	    "D8": "D8_dermatology_manifest.json",
    71	    "D9": "D9_brain_mri_manifest.json",
    72	    "D10": "D10_liver_ct_manifest.json",
    73	    "D11": "D11_gi_endoscopy_manifest.json",
    74	    "D12": "D12_road_safety_manifest.json",
    75	}
    76	
    77	MULTI_CLASS_DOMAINS = {"D1", "D2", "D3", "D4", "D5", "D6"}
    78	
    79	
    80	# ---------------------------------------------------------------------------
    81	# Rulebook granularity: group manifest items into (domain, class) buckets.
    82	# ---------------------------------------------------------------------------
    83	
    84	def group_units(manifest):
    85	    """Return dict: unit_key -> list[items].
    86	
    87	    unit_key is (domain_code, category) for multi-class domains,
    88	    (domain_code,) for single-class domains.
    89	    """
    90	    groups = {}
    91	    for it in manifest:
    92	        d = it.get("domain_code")
    93	        c = it.get("category")
    94	        key = (d, c) if d in MULTI_CLASS_DOMAINS else (d,)
    95	        groups.setdefault(key, []).append(it)
    96	    return groups
    97	
    98	
    99	def collect_unit_refs(items):
   100	    """Collect unique ref image paths across items in a unit."""
   101	    seen, refs = set(), []
   102	    for it in items:
   103	        for p in it.get("ref_paths", []) or []:
   104	            if p not in seen:
   105	                seen.add(p)
   106	                refs.append(p)
   107	    return refs
   108	
   109	
   110	def unit_label(unit_key):
   111	    """Human-readable unit name for prompts."""
   112	    if len(unit_key) == 2:
   113	        return f"{unit_key[0]} / {unit_key[1]}"
   114	    return f"{unit_key[0]}"
   115	
   116	
   117	# ---------------------------------------------------------------------------
   118	# L1: ref-only reflector
   119	# ---------------------------------------------------------------------------
   120	
   121	L1_SYSTEM = (
   122	    "You are a visual anomaly-detection expert. You will see several "
   123	    "NORMAL reference images of a specific class. Your job is to write "
   124	    "a persistent natural-language rulebook that another agent will "
   125	    "consult when it later sees a query image from the SAME class and "
   126	    "must decide whether the query is anomalous."
   127	)
   128	
   129	L1_USER_TEMPLATE = """Class: {unit_name}
   130	Number of reference images: {n_refs}
   131	All reference images shown below are NORMAL examples.
   132	
   133	Emit a strict-JSON rulebook in EXACTLY this shape (no extra keys, no \
   134	prose outside JSON):
   135	
   136	{{
   137	  "normal_signature": [
   138	    "short phrase describing an invariant feature of the normal class",
   139	    "...",
   140	    "..."
   141	  ],
   142	  "hypothesized_anomaly_modes": [
   143	    "plausible defect A expected to occur on this class (reason about \
   144	the object's function/structure, not just appearance)",
   145	    "plausible defect B",
   146	    "..."
   147	  ],
   148	  "rules": [
   149	    "if <visible predicate> then lean anomaly",
   150	    "if <visible predicate> then lean normal",
   151	    "..."
   152	  ]
   153	}}
   154	
   155	Guidelines:
   156	  - 3 to 6 items per list; be specific, not generic.
   157	  - Anomaly modes MUST be present: list at least 3 plausible ways this \
   158	class can fail, even though no defective image is shown. Use functional \
   159	reasoning (e.g. 'hazelnuts should be roughly spherical with a single \
   160	intact shell; a crack or missing half is a visible failure').
   161	  - Rules must be testable on a single image (no counterfactuals).
   162	  - Output JSON only; no markdown, no explanation.
   163	"""
   164	
   165	
   166	def build_l1_rulebook(unit_key, ref_paths, client, model, n_refs=8,
   167	                      max_retries=3):
   168	    """Ask a reflector VLM to emit a rulebook for one (domain, class) unit.
   169	
   170	    Returns dict with keys: normal_signature, hypothesized_anomaly_modes,
   171	    rules, plus meta fields (unit, n_refs_seen).
   172	    """
   173	    refs_used = ref_paths[:n_refs]
   174	    parts = []
   175	    for rp in refs_used:
   176	        parts.append(img_msg(load_and_encode(rp)))
   177	    parts.append(text_msg(L1_USER_TEMPLATE.format(
   178	        unit_name=unit_label(unit_key), n_refs=len(refs_used))))
   179	    messages = [
   180	        {"role": "system", "content": L1_SYSTEM},
   181	        {"role": "user", "content": parts},
   182	    ]
   183	    for _ in range(max_retries):
   184	        try:
   185	            resp_text, _, _ = call_llm(client, model, messages, temperature=0.0)
   186	            parsed = extract_json(resp_text)
   187	            if (isinstance(parsed, dict)
   188	                    and "normal_signature" in parsed
   189	                    and "hypothesized_anomaly_modes" in parsed):
   190	                parsed.setdefault("rules", [])
   191	                return {
   192	                    "unit": list(unit_key),
   193	                    "n_refs_seen": len(refs_used),
   194	                    "rulebook": parsed,
   195	                }
   196	        except Exception as e:  # pragma: no cover - log and retry
   197	            print(f"[L1 reflect] retry after error: {e}", file=sys.stderr)
   198	            time.sleep(1.0)
   199	    raise RuntimeError(f"L1 reflector failed for {unit_key}")
   200	
   201	
   202	# ---------------------------------------------------------------------------
   203	# L2: active verbalized reflector (dev oracle + agent trajectory)
   204	# ---------------------------------------------------------------------------
   205	
   206	L2_SYSTEM = (
   207	    "You are a visual anomaly-detection expert. A colleague agent just "
   208	    "ran on a DEV image and was uncertain. The ground-truth label has "
   209	    "been revealed to you. Your job is to propose ONE corrective rule "
   210	    "that, if added to the agent's rulebook, would have prevented the "
   211	    "mistake or reduced its uncertainty."
   212	)
   213	
   214	L2_USER_TEMPLATE = """DEV item: {item_id}
   215	Class: {unit_name}
   216	Agent predicted anomaly score: {score:.3f}  (0=normal, 1=anomaly)
   217	GROUND-TRUTH label: {gt_name} (={gt_int})
   218	
   219	Existing L1 rulebook for this class:
   220	{l1_json}
   221	
   222	Agent trajectory (condensed):
   223	{trajectory}
   224	
   225	Emit strict JSON, exactly ONE rule, of this shape:
   226	
   227	{{
   228	  "rule_type": "anomaly_mode_extension" | "normal_tolerance" | "rule",
   229	  "text": "short actionable rule, <= 25 words",
   230	  "justification": "<= 40 words explaining why this rule resolves the \
   231	dev item"
   232	}}
   233	
   234	Guidelines:
   235	  - Use "anomaly_mode_extension" when agent underpredicted anomaly (gt=1, score<0.5).
   236	  - Use "normal_tolerance" when agent overpredicted anomaly (gt=0, score>0.5).
   237	  - Use "rule" for a clean if-then predicate that applies more broadly.
   238	  - Do NOT restate the ground truth. Do NOT name the specific dev item.
   239	  - The rule must generalise to unseen test items of the SAME class.
   240	  - Output JSON only.
   241	"""
   242	
   243	
   244	def _compact_trajectory(v9_item_result, max_chars=800):
   245	    """Render a v9 per-item result dict into a compact trajectory string."""
   246	    r = v9_item_result
   247	    parts = []
   248	    if r.get("initial_score") is not None:
   249	        parts.append(f"initial_score={r['initial_score']}")
   250	    cf = r.get("candidate_features") or []
   251	    if cf:
   252	        parts.append("candidate_features=" + "; ".join(str(x) for x in cf[:5]))
   253	    rv = r.get("refutation_verdicts") or []
   254	    if rv:
   255	        parts.append("refutation=" + "; ".join(
   256	            f"t{v.get('turn')}:{v.get('verdict')}" for v in rv))
   257	    rm = r.get("remaining_features") or []
   258	    if rm:
   259	        parts.append("remaining=" + "; ".join(str(x) for x in rm[:5]))
   260	    tools = r.get("tools_used") or []
   261	    if tools:
   262	        parts.append("tools=" + ",".join(str(t) for t in tools[:5]))
   263	    rat = r.get("rationale") or ""
   264	    if rat:
   265	        parts.append("rationale=" + rat[:300])
   266	    s = "\n".join(parts)
   267	    return s[:max_chars]
   268	
   269	
   270	def build_l2_rulebook(unit_key, oracle_items, passive_results, l1_rulebook,
   271	                      client, model, max_retries=3):
   272	    """Build L2 corrective rules from K oracle dev items.
   273	
   274	    Args:
   275	      oracle_items: list of manifest items (dev split), already selected by
   276	        uncertainty (|s-0.5| ascending).
   277	      passive_results: list of v9 result dicts matching oracle_items 1:1.
   278	      l1_rulebook: dict (may be empty) — gives the reflector context.
   279	
   280	    Returns dict {unit, k, rules: [rule, ...]} — rules is a list of
   281	    {rule_type, text, justification, from_item}.
   282	    """
   283	    l1_json = json.dumps(l1_rulebook.get("rulebook", {}), indent=2)
   284	    out_rules = []
   285	    for item, res in zip(oracle_items, passive_results):
   286	        gt = int(item.get("label", 0))
   287	        gt_name = "ANOMALY" if gt == 1 else "NORMAL"
   288	        prompt = L2_USER_TEMPLATE.format(
   289	            item_id=item["item_id"],
   290	            unit_name=unit_label(unit_key),
   291	            score=float(res.get("score", 0.5)),
   292	            gt_name=gt_name, gt_int=gt,
   293	            l1_json=l1_json,
   294	            trajectory=_compact_trajectory(res),
   295	        )
   296	        messages = [
   297	            {"role": "system", "content": L2_SYSTEM},
   298	            {"role": "user", "content": [
   299	                img_msg(load_and_encode(item["query_path"])),
   300	                text_msg(prompt),
   301	            ]},
   302	        ]
   303	        for _ in range(max_retries):
   304	            try:
   305	                resp = call_llm(client, model, messages, temperature=0.0)
   306	                parsed = extract_json(resp)
   307	                if (isinstance(parsed, dict)
   308	                        and "rule_type" in parsed and "text" in parsed):
   309	                    parsed["from_item"] = item["item_id"]
   310	                    out_rules.append(parsed)
   311	                    break
   312	            except Exception as e:
   313	                print(f"[L2 reflect] retry ({item['item_id']}): {e}",
   314	                      file=sys.stderr)
   315	                time.sleep(1.0)
   316	    return {
   317	        "unit": list(unit_key),
   318	        "k": len(oracle_items),
   319	        "rules": out_rules,
   320	    }
   321	
   322	
   323	# ---------------------------------------------------------------------------
   324	# Rulebook stacking and injection
   325	# ---------------------------------------------------------------------------
   326	
   327	def stack_rulebook(l1, l2):
   328	    """Merge L1 ref-only rulebook with L2 corrective rules.
   329	
   330	    De-duplication is string-level on the ``rules`` list.
   331	    """
   332	    rb = dict(l1.get("rulebook", {})) if l1 else {}
   333	    rb.setdefault("normal_signature", [])
   334	    rb.setdefault("hypothesized_anomaly_modes", [])
   335	    rb.setdefault("rules", [])
   336	
   337	    for r in (l2 or {}).get("rules", []):
   338	        text = r.get("text", "").strip()
   339	        if not text:
   340	            continue
   341	        tagged = f"(corrective) {text}"
   342	        if r.get("rule_type") == "anomaly_mode_extension":
   343	            if text not in rb["hypothesized_anomaly_modes"]:
   344	                rb["hypothesized_anomaly_modes"].append(text)
   345	        elif r.get("rule_type") == "normal_tolerance":
   346	            if text not in rb["normal_signature"]:
   347	                rb["normal_signature"].append(text)
   348	        if tagged not in rb["rules"]:
   349	            rb["rules"].append(tagged)
   350	    return rb
   351	
   352	
   353	def rulebook_to_prompt(rb):
   354	    """Render a rulebook dict as the DOMAIN RULEBOOK block injected into v9."""
   355	    return (
   356	        "DOMAIN RULEBOOK for this class (read before reasoning):\n"
   357	        + json.dumps(rb, indent=2, ensure_ascii=False)
   358	    )
   359	
   360	
   361	# ---------------------------------------------------------------------------
   362	# Oracle selection: lowest-confidence K dev items from a passive-v9 run
   363	# ---------------------------------------------------------------------------
   364	
   365	def select_oracle_items(passive_dev_results, manifest_by_id, k=10):
   366	    """Pick the K dev items with smallest |score - 0.5|.
   367	
   368	    Returns (oracle_items, oracle_results) 1:1 aligned lists.
   369	    """
   370	    ranked = sorted(
   371	        passive_dev_results,
   372	        key=lambda r: abs(float(r.get("score", 0.5)) - 0.5),
   373	    )
   374	    chosen = ranked[:k]
   375	    items = [manifest_by_id[r["item_id"]] for r in chosen]
   376	    return items, chosen
   377	
   378	
   379	# ---------------------------------------------------------------------------
   380	# I/O
   381	# ---------------------------------------------------------------------------
   382	
   383	def write_json(path, obj):
   384	    Path(path).parent.mkdir(parents=True, exist_ok=True)
   385	    Path(path).write_text(json.dumps(obj, indent=2, ensure_ascii=False))
   386	
   387	
   388	def read_json(path):
   389	    return json.loads(Path(path).read_text())
   390	
   391	
   392	# ---------------------------------------------------------------------------
   393	# CLI: three subcommands (build-l1 / build-l2 / eval-test)
   394	# ---------------------------------------------------------------------------
   395	
   396	def cmd_build_l1(args):
   397	    manifest = read_json(args.manifest)
   398	    client = get_client(args.backend)
   399	    model = get_model_name(args.backend)
   400	    groups = group_units(manifest)
   401	
   402	    out = {"domain": None, "units": []}
   403	    for unit_key, items in groups.items():
   404	        out["domain"] = unit_key[0]
   405	        refs = collect_unit_refs(items)
   406	        if args.seed is not None:
   407	            rng = random.Random(args.seed)
   408	            rng.shuffle(refs)
   409	        rb = build_l1_rulebook(unit_key, refs, client, model,
   410	                               n_refs=args.n_refs)
   411	        out["units"].append(rb)
   412	        print(f"[L1] {unit_key}: rules={len(rb['rulebook'].get('rules', []))}, "
   413	              f"modes={len(rb['rulebook'].get('hypothesized_anomaly_modes', []))}")
   414	    write_json(args.out, out)
   415	    print(f"[L1] wrote {args.out}")
   416	
   417	
   418	def cmd_build_l2(args):
   419	    manifest = read_json(args.manifest)
   420	    passive = read_json(args.passive_dev)  # list of V9Result-as-dict
   421	    l1 = read_json(args.l1) if args.l1 else {"units": []}
   422	    manifest_by_id = {it["item_id"]: it for it in manifest}
   423	    groups = group_units(manifest)
   424	    l1_by_unit = {tuple(u["unit"]): u for u in l1.get("units", [])}
   425	
   426	    # Filter passive results to dev split only.
   427	    dev_ids = {it["item_id"] for it in manifest if it.get("split") == "dev"}
   428	    passive_dev = [r for r in passive if r["item_id"] in dev_ids]
   429	
   430	    client = get_client(args.backend)
   431	    model = get_model_name(args.backend)
   432	
   433	    out = {"domain": None, "units": []}
   434	    for unit_key, items in groups.items():
   435	        out["domain"] = unit_key[0]
   436	        unit_ids = {it["item_id"] for it in items
   437	                    if it.get("split") == "dev"}
   438	        unit_passive = [r for r in passive_dev
   439	                        if r["item_id"] in unit_ids]
   440	        if not unit_passive:
   441	            print(f"[L2] {unit_key}: no passive-dev results, skip")
   442	            continue
   443	        oracle_items, oracle_results = select_oracle_items(
   444	            unit_passive, manifest_by_id, k=args.k)
   445	        l1_rb = l1_by_unit.get(unit_key, {"rulebook": {}})
   446	        rb = build_l2_rulebook(unit_key, oracle_items, oracle_results,
   447	                               l1_rb, client, model)
   448	        out["units"].append(rb)
   449	        print(f"[L2] {unit_key}: k={rb['k']}, new_rules={len(rb['rules'])}")
   450	    write_json(args.out, out)
   451	    print(f"[L2] wrote {args.out}")
   452	
   453	
   454	def cmd_stack(args):
   455	    l1 = read_json(args.l1)
   456	    l2 = read_json(args.l2)
   457	    l1_by = {tuple(u["unit"]): u for u in l1.get("units", [])}
   458	    l2_by = {tuple(u["unit"]): u for u in l2.get("units", [])}
   459	    out = {"domain": l1.get("domain") or l2.get("domain"), "units": []}
   460	    for key in sorted(set(l1_by) | set(l2_by)):
   461	        rb = stack_rulebook(l1_by.get(key, {}), l2_by.get(key, {}))
   462	        out["units"].append({"unit": list(key), "rulebook": rb})
   463	    write_json(args.out, out)
   464	    print(f"[stack] wrote {args.out}: {len(out['units'])} units")
   465	
   466	
   467	def cmd_eval_test(args):
   468	    """Run v9 on test items with a pre-built rulebook injected.
   469	
   470	    The rulebook is looked up by (domain_code, category).  Rulebook
   471	    string is injected via the `rulebook` kwarg of v9_mod.run_v9_item
   472	    (see patch to agent_v9.py).
   473	    """
   474	    manifest = read_json(args.manifest)
   475	    rulebook_file = read_json(args.rulebook)
   476	    rb_by_unit = {tuple(u["unit"]): u["rulebook"]
   477	                  for u in rulebook_file.get("units", [])}
   478	    test_items = [it for it in manifest if it.get("split") == "test"]
   479	
   480	    client = get_client(args.backend)
   481	    model = get_model_name(args.backend)
   482	
   483	    results = []
   484	    def _run_one(it):
   485	        d = it.get("domain_code")
   486	        c = it.get("category")
   487	        key = (d, c) if d in MULTI_CLASS_DOMAINS else (d,)
   488	        rb = rb_by_unit.get(key) or {}
   489	        rulebook_str = rulebook_to_prompt(rb) if rb else None
   490	        return v9_mod.run_v9_item(
   491	            client, model, it, split="test",
   492	            max_turns=args.max_turns,
   493	            rulebook=rulebook_str,  # NEW kwarg; see agent_v9 patch
   494	        )
   495	
   496	    with ThreadPoolExecutor(max_workers=args.workers) as ex:
   497	        fut = {ex.submit(_run_one, it): it for it in test_items}
   498	        for f in as_completed(fut):
   499	            it = fut[f]
   500	            try:
   501	                r = f.result()
   502	                results.append({
   503	                    "item_id": r.item_id,
   504	                    "score": r.score,
   505	                    "mode": r.mode,
   506	                    "rationale": r.rationale,
   507	                    "label": it.get("label"),
   508	                    "domain_code": it.get("domain_code"),
   509	                    "category": it.get("category"),
   510	                })
   511	            except Exception as e:
   512	                print(f"[eval] {it['item_id']} failed: {e}", file=sys.stderr)
   513	    write_json(args.out, results)
   514	    print(f"[eval-test] wrote {args.out}: {len(results)} items")
   515	
   516	
   517	def main():
   518	    ap = argparse.ArgumentParser()
   519	    sub = ap.add_subparsers(dest="cmd", required=True)
   520	
   521	    ap_l1 = sub.add_parser("build-l1")
   522	    ap_l1.add_argument("--manifest", required=True)
   523	    ap_l1.add_argument("--out", required=True)
   524	    ap_l1.add_argument("--n_refs", type=int, default=8)
   525	    ap_l1.add_argument("--seed", type=int, default=0)
   526	    ap_l1.add_argument("--backend", default="qwen3")
   527	    ap_l1.set_defaults(func=cmd_build_l1)
   528	
   529	    ap_l2 = sub.add_parser("build-l2")
   530	    ap_l2.add_argument("--manifest", required=True)
   531	    ap_l2.add_argument("--passive_dev", required=True,
   532	                       help="JSON array of v9 per-item results on dev.")
   533	    ap_l2.add_argument("--l1", default=None)
   534	    ap_l2.add_argument("--out", required=True)
   535	    ap_l2.add_argument("--k", type=int, default=10)
   536	    ap_l2.add_argument("--backend", default="qwen3")
   537	    ap_l2.set_defaults(func=cmd_build_l2)
   538	
   539	    ap_st = sub.add_parser("stack")
   540	    ap_st.add_argument("--l1", required=True)
   541	    ap_st.add_argument("--l2", required=True)
   542	    ap_st.add_argument("--out", required=True)
   543	    ap_st.set_defaults(func=cmd_stack)
   544	
   545	    ap_ev = sub.add_parser("eval-test")
   546	    ap_ev.add_argument("--manifest", required=True)
   547	    ap_ev.add_argument("--rulebook", required=True)
   548	    ap_ev.add_argument("--out", required=True)
   549	    ap_ev.add_argument("--backend", default="qwen3")
   550	    ap_ev.add_argument("--max_turns", type=int, default=3)
   551	    ap_ev.add_argument("--workers", type=int, default=3)
   552	    ap_ev.set_defaults(func=cmd_eval_test)
   553	
   554	    args = ap.parse_args()
   555	    args.func(args)
   556	
   557	
   558	if __name__ == "__main__":
   559	    main()

