     1	"""Controlled ablation: does middle-zone mass CAUSE ensemble gain, or
     2	is it correlated with something else (standalone AUROC, error
     3	complementarity)?
     4	
     5	Transformations applied to the v6.5 agent's scores and the v8 agent's
     6	scores on Qwen3.5 test (post-hoc, no new inference):
     7	
     8	  v6-BIN:   quantize v6.5 scores to {0.05, 0.95} (remove middle mass).
     9	  v8-SOFT:  remap v8 scores through a sigmoid-compressing function to
    10	            inflate middle mass (Platt-like): x → 0.5 + (x-0.5)/2.
    11	  SHUFFLE:  random middle-mass control — replace v6.5 scores with
    12	            uniform[0.2, 0.8] noise. Measures whether random middle
    13	            mass alone helps the ensemble.
    14	
    15	If the score-diversity hypothesis holds:
    16	  - v6-BIN + Direct should drop toward Direct alone (loses middle mass).
    17	  - v8-SOFT + Direct should rise toward v6 + Direct (gains middle mass).
    18	  - SHUFFLE + Direct should give ZERO gain (random noise has no signal).
    19	
    20	We also report rank correlation and per-item error complementarity
    21	between the base scores as supplementary diagnostics.
    22	"""
    23	from __future__ import annotations
    24	import json
    25	import numpy as np
    26	from sklearn.metrics import roc_auc_score
    27	from scipy.stats import spearmanr
    28	from collections import defaultdict
    29	
    30	
    31	def macro(items, get_score):
    32	    by_d = defaultdict(list)
    33	    for x in items:
    34	        if x.get("label_gt") is None:
    35	            continue
    36	        by_d[x["domain_code"]].append(x)
    37	    aurocs = []
    38	    for d, it in by_d.items():
    39	        y = [i["label_gt"] for i in it]
    40	        s = [get_score(i) for i in it]
    41	        if len(set(y)) > 1:
    42	            aurocs.append(roc_auc_score(y, s))
    43	    return float(np.mean(aurocs))
    44	
    45	
    46	def main():
    47	    direct = {x["item_id"]: x for x in
    48	              json.load(open("benchmark/results/v6_direct_qwen3_test.json"))}
    49	    v65 = {x["item_id"]: x for x in
    50	           json.load(open("benchmark/results/v6_5_agent_qwen3_test.json"))}
    51	    v8 = {x["item_id"]: x for x in
    52	          json.load(open("benchmark/results/v8_qwen3_test.json"))}
    53	
    54	    # Common item set
    55	    items = [x for x in direct.values() if x["item_id"] in v65 and x["item_id"] in v8]
    56	    print(f"n={len(items)}")
    57	
    58	    def quantize_v65(i):
    59	        s = v65[i["item_id"]]["anomaly_score"]
    60	        return 0.05 if s < 0.5 else 0.95
    61	
    62	    rng = np.random.default_rng(42)
    63	    rand_map = {i["item_id"]: rng.uniform(0.2, 0.8) for i in items}
    64	    def shuffle_val(i):
    65	        return rand_map[i["item_id"]]
    66	
    67	    # Also compute a "preserve rank, binarize to 0.05/0.95" for v65 AND a
    68	    # sigmoid-compressed v8 that preserves rank but squeezes into [0.2, 0.8]
    69	    v65_scores = np.array([v65[i["item_id"]]["anomaly_score"] for i in items])
    70	    v8_scores = np.array([v8[i["item_id"]]["anomaly_score"] for i in items])
    71	    # v65-bin: map median-split to {0.05, 0.95}
    72	    v65_med = np.median(v65_scores)
    73	    def v65_bin(i):
    74	        return 0.95 if v65[i["item_id"]]["anomaly_score"] > v65_med else 0.05
    75	    # v8-soft: sigmoid compression, preserves rank
    76	    # y = 0.5 + (x - 0.5) / 2  ⇒ maps [0,1] to [0.25, 0.75]
    77	    def v8_soft(i):
    78	        x = v8[i["item_id"]]["anomaly_score"]
    79	        return 0.5 + (x - 0.5) / 2
    80	
    81	    # Headline AUROCs
    82	    print()
    83	    print("=== Standalone AUROCs ===")
    84	    for name, fn in [("Direct",                lambda i: direct[i["item_id"]]["anomaly_score"]),
    85	                     ("v6.5 original",         lambda i: v65[i["item_id"]]["anomaly_score"]),
    86	                     ("v6.5 BIN (rank-preserving {0.05,0.95})", v65_bin),
    87	                     ("v8 original",           lambda i: v8[i["item_id"]]["anomaly_score"]),
    88	                     ("v8 SOFT (compressed to [0.25,0.75])", v8_soft),
    89	                     ("RANDOM middle-mass",    shuffle_val)]:
    90	        m = macro(items, fn)
    91	        print(f"  {name:45s} {m:.4f}")
    92	
    93	    print()
    94	    print("=== 0.5 × Direct + 0.5 × X ===")
    95	    for name, fn in [("v6.5 original",           lambda i: v65[i["item_id"]]["anomaly_score"]),
    96	                     ("v6.5 BIN",                v65_bin),
    97	                     ("v8 original",             lambda i: v8[i["item_id"]]["anomaly_score"]),
    98	                     ("v8 SOFT",                 v8_soft),
    99	                     ("RANDOM middle-mass",      shuffle_val),
   100	                     ("v6.5 original * Direct (geomean)", lambda i: (direct[i["item_id"]]["anomaly_score"] * v65[i["item_id"]]["anomaly_score"])**0.5)]:
   101	        def blend(i, fn=fn):
   102	            return 0.5 * direct[i["item_id"]]["anomaly_score"] + 0.5 * fn(i)
   103	        m = macro(items, blend)
   104	        print(f"  0.5 Direct + 0.5 {name:45s} {m:.4f}")
   105	
   106	    # Middle-zone mass computation
   107	    print()
   108	    print("=== Middle-zone mass and std ===")
   109	    for name, vals in [
   110	        ("Direct",         np.array([direct[i["item_id"]]["anomaly_score"] for i in items])),
   111	        ("v6.5 original",  v65_scores),
   112	        ("v6.5 BIN",       np.array([v65_bin(i) for i in items])),
   113	        ("v8 original",    v8_scores),
   114	        ("v8 SOFT",        np.array([v8_soft(i) for i in items])),
   115	        ("RANDOM",         np.array([shuffle_val(i) for i in items])),
   116	    ]:
   117	        mid = ((vals >= 0.2) & (vals <= 0.8)).mean() * 100
   118	        print(f"  {name:45s} mean={vals.mean():.3f} std={vals.std():.3f} mid%={mid:.1f}")
   119	
   120	    # Rank correlation and error complementarity diagnostics
   121	    print()
   122	    print("=== Rank correlation (Spearman ρ) with Direct ===")
   123	    dr = np.array([direct[i["item_id"]]["anomaly_score"] for i in items])
   124	    for name, s in [("v6.5 original", v65_scores), ("v6.5 BIN", np.array([v65_bin(i) for i in items])),
   125	                     ("v8 original", v8_scores), ("v8 SOFT", np.array([v8_soft(i) for i in items])),
   126	                     ("RANDOM",      np.array([shuffle_val(i) for i in items]))]:
   127	        rho, _ = spearmanr(dr, s)
   128	        print(f"  {name:45s} ρ={rho:.3f}")
   129	
   130	    print()
   131	    print("=== Per-item error complementarity ===")
   132	    y = np.array([i["label_gt"] for i in items])
   133	    dr_err = np.abs(dr - y)
   134	    for name, s in [("v6.5 original", v65_scores), ("v6.5 BIN", np.array([v65_bin(i) for i in items])),
   135	                     ("v8 original", v8_scores), ("v8 SOFT", np.array([v8_soft(i) for i in items])),
   136	                     ("RANDOM",      np.array([shuffle_val(i) for i in items]))]:
   137	        err = np.abs(s - y)
   138	        cos = np.dot(dr_err, err) / (np.linalg.norm(dr_err) * np.linalg.norm(err) + 1e-12)
   139	        print(f"  {name:45s} error-cos with Direct = {cos:.3f}")
   140	
   141	
   142	if __name__ == "__main__":
   143	    main()

