import json, os
from collections import defaultdict
# same metric helpers

def auc(y,s):
    y=list(map(int,y)); s=list(map(float,s)); n=len(y); n1=sum(y); n0=n-n1
    if n1==0 or n0==0: return None
    order=sorted(range(n), key=lambda i:s[i])
    ranks=[0]*n; i=0
    while i<n:
        j=i
        while j+1<n and s[order[j+1]]==s[order[i]]: j+=1
        avg=(i+1+j+1)/2
        for k in range(i,j+1): ranks[order[k]]=avg
        i=j+1
    return (sum(r for r,yy in zip(ranks,y) if yy==1)-n1*(n1+1)/2)/(n1*n0)
manifest=json.load(open('benchmark/manifests/full_manifest.json'))
labels={x['item_id']:x['label'] for x in manifest}; domains={x['item_id']:x['domain_code'] for x in manifest}
def macro(path):
    try: data=json.load(open(path))
    except Exception as e: return None
    by=defaultdict(list); n=0
    if isinstance(data,dict):
        for key in ['results','items','predictions']:
            if key in data and isinstance(data[key],list): data=data[key]; break
    if not isinstance(data,list): return None
    for r in data:
        if not isinstance(r,dict): continue
        iid=r.get('item_id')
        score=r.get('anomaly_score') if r.get('anomaly_score') is not None else r.get('score')
        if score is None: continue
        y=r.get('label_gt')
        if y is None: y=r.get('label')
        if y is None and iid in labels: y=labels[iid]
        if y is None: continue
        d=r.get('domain_code') or r.get('domain') or domains.get(iid)
        by[d].append((int(y),float(score))); n+=1
    vals={d:auc([y for y,s in ys],[s for y,s in ys]) for d,ys in by.items()}
    vals={d:v for d,v in vals.items() if v is not None}
    if not vals: return None
    return n, sum(vals.values())/len(vals), vals
files=[f'benchmark/results/{x}' for x in os.listdir('benchmark/results') if x.endswith('.json')]
for f in sorted(files):
    base=os.path.basename(f)
    if any(k in base.lower() for k in ['seedvl','gpt','qwen','v6','anomaclaw_v4']):
        m=macro(f)
        if m and (0.775<m[1]<0.825 or base.startswith('anomaclaw_v4_seedvl')):
            print(base, 'n',m[0], 'macro',round(m[1],6))
