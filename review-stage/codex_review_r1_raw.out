# triple q and gdev
q= {i: dict(D['direct_q'][i], anomaly_score=0.5*float(D['direct_q'][i]['anomaly_score'])+0.1*float(D['v65_q'][i]['anomaly_score'])+0.4*float(D['v8_q'][i]['anomaly_score'])) for i in set(D['direct_q'])&set(D['v65_q'])&set(D['v8_q'])}
print('q triple', len(q), macro(q)[0])
