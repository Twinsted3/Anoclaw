import json, glob, os
import numpy as np
from sklearn.metrics import roc_auc_score

def load(pat):
    d={}
    for fp in glob.glob(pat):
        for r in json.load(open(fp)):
            iid=r['item_id']; d[iid]=(r.get('domain_code') or iid.split('_')[0], int(r.get('label',r.get('label_gt'))), float(r.get('score',r.get('anomaly_score'))))
    return d
base=load('benchmark/results/verbalized/passive_test/*.json')
vars={
 'anchor':load('benchmark/results/verbalized/v3_eval_anchor/*.json'),
 'l1':load('benchmark/results/verbalized/v3_eval_l1/*.json'),
 'l2':load('benchmark/results/verbalized/v3_eval_l2/*.json'),
 'l1l2':load('benchmark/results/verbalized/v3_eval_l1l2/*.json')}
common=sorted(set(base)&set(next(iter(vars.values()))))
doms=sorted({base[i][0] for i in common})
bydom={d:[i for i in common if base[i][0]==d] for d in doms}

def run(var, seed, label_strat=False, n=1000):
    rng=np.random.default_rng(seed)
    def diff(ids_by_d):
        ds=[]
        for d,ids in ids_by_d.items():
            y=[base[i][1] for i in ids]
            if len(set(y))<2: continue
            ds.append(roc_auc_score(y,[var[i][2] for i in ids])-roc_auc_score(y,[base[i][2] for i in ids]))
        return np.mean(ds)
    pt=diff(bydom)
    arr=[]
    for _ in range(n):
        boot={}
        for d,pool in bydom.items():
            if label_strat:
                samp=[]
                for lab in (0,1):
                    sub=[i for i in pool if base[i][1]==lab]
                    samp += rng.choice(sub,len(sub),True).tolist()
            else:
                samp=rng.choice(pool,len(pool),True).tolist()
            boot[d]=samp
        arr.append(diff(boot))
    arr=np.array(arr)
    return pt*100, np.percentile(arr,[2.5,97.5])*100, (arr>0).mean()
for seed in [0,1,42,123,20260415,20260420,20260422]:
    print('seed',seed)
    for label_strat in [False, True]:
        print(' label',label_strat)
        for name in vars:
            pt,ci,p=run(vars[name],seed,label_strat)
            print(f'  {name:6s} {pt:+.2f} [{ci[0]:+.2f},{ci[1]:+.2f}] P={p:.3f}')
