   463	def _load_retrieval_model_v6(device: str = "cuda"):
   464	    if "model" in _RETRIEVAL_CACHE:
   465	        return _RETRIEVAL_CACHE["model"], _RETRIEVAL_CACHE["transform"]
   466	    with _RETRIEVAL_LOCK:
   467	        if "model" in _RETRIEVAL_CACHE:  # double-check after acquiring lock
   468	            return _RETRIEVAL_CACHE["model"], _RETRIEVAL_CACHE["transform"]
   469	        import torch  # noqa: F401
   470	        import timm
   471	        model = timm.create_model("vit_small_patch14_dinov2.lvd142m",
   472	                                  pretrained=True, num_classes=0)
   473	        model = model.to(device).eval()
   474	        cfg = timm.data.resolve_data_config(model.pretrained_cfg)
   475	        transform = timm.data.create_transform(**cfg, is_training=False)
   476	        _RETRIEVAL_CACHE["model"] = model
   477	        _RETRIEVAL_CACHE["transform"] = transform
   478	        return model, transform
