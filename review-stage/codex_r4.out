import json, glob, os
import numpy as np
from sklearn.metrics import roc_auc_score

def load(pat):
    d={}
    for fp in glob.glob(pat):
        for r in json.load(open(fp)):
            iid=r['item_id']; dom=r.get('domain_code') or iid.split('_')[0]
            d[iid]=(dom,int(r.get('label',r.get('label_gt'))),float(r.get('score',r.get('anomaly_score'))))
    return d
base=load('benchmark/results/verbalized/passive_test/*.json')
variants={
 'anchor':load('benchmark/results/verbalized/v3_eval_anchor/*.json'),
 'l1':load('benchmark/results/verbalized/v3_eval_l1/*.json'),
 'l2':load('benchmark/results/verbalized/v3_eval_l2/*.json'),
 'l1l2':load('benchmark/results/verbalized/v3_eval_l1l2/*.json'),
}

def boot(var, n=1000, seed=42, label_strat=False):
    common=sorted(set(base)&set(var))
    doms=sorted({base[i][0] for i in common})
    bydom={d:[i for i in common if base[i][0]==d] for d in doms}
    rng=np.random.default_rng(seed)
    def macro(ids):
        out=[]
        for d in doms:
            sel=[i for i in ids if base[i][0]==d]
            if len({base[i][1] for i in sel})<2: continue
            y=[base[i][1] for i in sel]
            out.append(roc_auc_score(y,[var[i][2] for i in sel])-roc_auc_score(y,[base[i][2] for i in sel]))
        return float(np.mean(out))
    deltas=[]
    for _ in range(n):
        ids=[]
        for d,pool in bydom.items():
            if label_strat:
                for lab in [0,1]:
                    sub=[i for i in pool if base[i][1]==lab]
                    ids.extend(rng.choice(sub,size=len(sub),replace=True).tolist())
            else:
                ids.extend(rng.choice(pool,size=len(pool),replace=True).tolist())
        deltas.append(macro(ids))
    arr=np.array(deltas)
    return np.percentile(arr,[2.5,97.5])*100, (arr>0).mean(), macro(common)*100
for label_strat in [False, True]:
    print('label_strat',label_strat)
    for name,var in variants.items():
        ci,p,pt=boot(var,seed=20260422,label_strat=label_strat)
        print(name, f'pt={pt:+.2f}', f'CI=[{ci[0]:+.2f},{ci[1]:+.2f}]', f'P={p:.3f}')
