/bin/bash -lc "python - <<'PY'
import json
from pathlib import Path
from sklearn.metrics import roc_auc_score
import numpy as np
for label,dirn in [('full','benchmark/results/verbalized/v11_eval_test'),('meta','benchmark/results/verbalized/v11_eval_test_meta_only'),('noR','benchmark/results/verbalized/v11_eval_test_no_rules')]:
    auc_bl=[]; auc_f=[]; diffs=[]
    print('\\n',label)
    for p in sorted(Path(dirn).glob('D*.json'), key=lambda p:int(p.stem[1:])):
        rows=json.load(open(p)); y=[]; bl=[]; fi=[]
        for x in rows:
            if x.get('label_gt') is None or x.get('v9_score') is None or x.get('direct_score') is None: continue
            y.append(int(x['label_gt'])); bl.append(0.5*float(x['v9_score'])+0.5*float(x['direct_score'])); fi.append(float(x.get('anomaly_score',bl[-1])))
        if len(set(y))<2: continue
        ab=roc_auc_score(y,bl); af=roc_auc_score(y,fi); auc_bl.append(ab); auc_f.append(af); diffs.append((af-ab)*100)
        print(p.stem, f'n={len(y)} blend={ab:.3f} final={af:.3f} d={100*(af-ab):+.2f}')
    print('macro own_blend', np.mean(auc_bl), 'final', np.mean(auc_f), 'delta_pp', 100*(np.mean(auc_f)-np.mean(auc_bl)))
