import json, collections, random
from sklearn.metrics import roc_auc_score
D={r['item_id']:r for r in json.load(open('benchmark/results/v6_direct_seedvl_test.json'))}
E={r['item_id']:r for r in json.load(open('benchmark/results/v6_ensemble_seedvl_test.json'))}
by=collections.defaultdict(list)
for i in sorted(set(D)&set(E)):
    by[D[i]['domain_code']].append(i)
def macro(ids_by_domain):
    vd=[]; ve=[]
    for dom, ids in ids_by_domain.items():
        y=[int(D[i]['label_gt']) for i in ids]
        sd=[float(D[i]['anomaly_score']) for i in ids]
        se=[float(E[i]['anomaly_score']) for i in ids]
        if len(set(y))<2: continue
        vd.append(roc_auc_score(y,sd)); ve.append(roc_auc_score(y,se))
    return sum(vd)/len(vd), sum(ve)/len(ve)
md,me=macro(by); print('macro',md,me,me-md)
rng=random.Random(42); deltas=[]
for _ in range(1000):
    sample_by={}
    for dom,ids in by.items():
        sample_by[dom]=[rng.choice(ids) for _ in ids]
    d,e=macro(sample_by); deltas.append(e-d)
s=sorted(deltas)
print('ci pp',s[24]*100,s[974]*100,'p',sum(x>0 for x in deltas)/len(deltas),'mean pp',sum(deltas)/len(deltas)*100)
