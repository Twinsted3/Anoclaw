import json, collections, os
from sklearn.metrics import roc_auc_score

def load_scores(f):
 data=json.load(open(f)); return data

def macro(f):
 data=load_scores(f); by=collections.defaultdict(list)
 for r in data: by[r['domain_code']].append(r)
 vals={}
 for d,sub in sorted(by.items()):
  y=[int(r['label_gt']) for r in sub]
  s=[float(r['anomaly_score']) for r in sub]
  vals[d]=roc_auc_score(y,s) if len(set(y))>1 else float('nan')
 return vals, sum(vals.values())/len(vals), len(data)
for f in ['benchmark/results/v6_direct_seedvl_test.json','benchmark/results/v6_ensemble_seedvl_test.json','benchmark/results/v6_ensemble_v6_seedvl_test.json','benchmark/results/v6_agent_seedvl_test.json','benchmark/results/seedvl_v0_direct_test_all_v2.json','benchmark/results/v6_fusion_seedvl_test.json']:
 if os.path.exists(f):
  vals,m,n=macro(f)
  print('\\n',f,'n',n,'macro',m)
  print(' '.join(f'{k}:{v:.4f}' for k,v in sorted(vals.items())))
# also paired item id overlap and whether ensemble equals 0.5 direct+agent
D={r['item_id']:r for r in json.load(open('benchmark/results/v6_direct_seedvl_test.json'))}
A={r['item_id']:r for r in json.load(open('benchmark/results/v6_agent_seedvl_test.json'))}
E={r['item_id']:r for r in json.load(open('benchmark/results/v6_ensemble_seedvl_test.json'))}
common=set(D)&set(A)&set(E)
print('\\ncommon',len(common))
errs=[]
for i in common:
    pred=(float(D[i]['anomaly_score'])+float(A[i]['anomaly_score']))/2
    errs.append(abs(pred-float(E[i]['anomaly_score'])))
print('max ensemble diff vs direct+agent',max(errs),'mean',sum(errs)/len(errs))
