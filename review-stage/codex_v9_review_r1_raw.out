import json, collections, math
from collections import defaultdict

def yes_label(answer, options):
    txt=str((options or {}).get(answer,'')).lower()
    # answer means anomaly if option text says yes/defect/anomal/there is
    if any(k in txt for k in ['yes','defect','anomal','there is']): return 1
    if any(k in txt for k in ['no','normal','not']): return 0
    return None

def auc(y,s):
    y=list(map(int,y)); s=list(map(float,s)); n=len(y); n1=sum(y); n0=n-n1
    if n1==0 or n0==0: return None
    order=sorted(range(n), key=lambda i:s[i]); ranks=[0]*n; i=0
    while i<n:
        j=i
        while j+1<n and s[order[j+1]]==s[order[i]]: j+=1
        avg=(i+1+j+1)/2
        for k in range(i,j+1): ranks[order[k]]=avg
        i=j+1
    return (sum(r for r,yy in zip(ranks,y) if yy)-n1*(n1+1)/2)/(n1*n0)
mm=json.load(open('MMAD/dataset/MMAD/mmad.json'))
lab={}
for key,v in mm.items():
    for idx,qa in enumerate(v.get('conversation',[])):
        if qa.get('type')=='Anomaly Detection':
            lab[f'{key}#q{idx}']=yes_label(qa.get('Answer'), qa.get('Options'))
r=json.load(open('benchmark/results/mmad_anomaly_qwen3.json'))
print('label counts by dataset using answer options')
for ds in sorted(set(x['dataset'] for x in r)):
    c=collections.Counter(lab[x['item_id']] for x in r if x['dataset']==ds)
    print(ds,c)
print('path-label mismatches against answer-options label')
for ds in sorted(set(x['dataset'] for x in r)):
    sub=[x for x in r if x['dataset']==ds]
    mis=sum(lab[x['item_id']]"'!=x['"'label_gt'] for x in sub)
    print(ds, mis, '/', len(sub))
for field in ['direct_score','agent_score','ensemble_score']:
    print('\\n',field)
    ys=[]; ss=[]
    for x in r:
        y=lab[x['item_id']]
        if y is not None and field in x:
            ys.append(y); ss.append(x[field])
    print('pooled',auc(ys,ss), 'n',len(ys),'pos',sum(ys))
    for ds in ['DS-MVTec','MVTec-LOCO','VisA','GoodsAD','MVTec-AD']:
        sub=[x for x in r if x['dataset']==ds and lab[x['item_id']] is not None]
        a=auc([lab[x['item_id']] for x in sub],[x[field] for x in sub]) if sub else None
        print(ds, a, 'n',len(sub),'pos',sum(lab[x['item_id']] for x in sub))
