        print(' first', {k:arr[0].get(k) for k in ['item_id','domain_code','label_gt','score','error','n_turns','fewshot'] if k in arr[0]})
    print('oracle ids',[(d.get('item_id'), d.get('label'), d.get('score'), d.get('error')) for d in out.get('oracle_items',[])[:3]])
