    38	
    39	DOMAIN_FILES = {
    40	    "D1": "D1_industrial_manifest.json",
    41	    "D2": "D2_retail_manifest.json",
    42	    "D3": "D3_complex_industrial_manifest.json",
    43	    "D4": "D4_infrastructure_manifest.json",
    44	    "D5": "D5_logical_manifest.json",
    45	    "D6": "D6_industrial_3d_manifest.json",
    46	    "D7": "D7_remote_sensing_manifest.json",
    47	    "D8": "D8_dermatology_manifest.json",
    48	    "D9": "D9_brain_mri_manifest.json",
    49	    "D10": "D10_liver_ct_manifest.json",
    50	    "D11": "D11_gi_endoscopy_manifest.json",
    51	    "D12": "D12_road_safety_manifest.json",
    52	}
    53	
    54	
    55	def dinov2_embed(image_path, device="cuda"):
    56	    """Return L2-normalised DINOv2 CLS embedding (384d)."""
    57	    from PIL import Image
    58	    import numpy as np
    59	    import torch
    60	    model, transform = _t7._load_retrieval_model_v6(device)
    61	    img = Image.open(image_path).convert("RGB")
    62	    t = transform(img).unsqueeze(0).to(device)
    63	    with torch.no_grad():
    64	        e = model(t).cpu().numpy().flatten()
    65	    return e / (np.linalg.norm(e) + 1e-8)
    66	
    67	
    68	def build_fewshot_context(oracle_pool, query_image, k=3):
    69	    """Retrieve top-k labelled neighbors by DINOv2 similarity.
    70	
    71	    oracle_pool: list of dicts {item_id, query_path, label, rationale}
    72	        each augmented with .embed (np.array 384).
    73	    Returns a list of dicts {query_path, label, rationale, similarity}.
    74	    """
    75	    import numpy as np
    76	    q_emb = dinov2_embed(query_image)
    77	    sims = np.array([float(q_emb @ x["embed"]) for x in oracle_pool])
    78	    if len(oracle_pool) == 0:
    79	        return []
    80	    top_idx = np.argsort(sims)[::-1][:k]
    81	    return [{"query_path": oracle_pool[i]["query_path"],
    82	             "label": oracle_pool[i]["label"],
    83	             "rationale": oracle_pool[i].get("rationale", ""),
    84	             "similarity": float(sims[i])} for i in top_idx]
    85	
    86	
    87	def run_one(client, model, item, split, max_turns, fewshot=None):
    88	    """Wrap v9 runner with optional fewshot injection (thread-safe via kwarg)."""
    89	    return v9_mod.run_v9_item(client, model, item, split, max_turns,
    90	                              fewshot_context=fewshot)
    91	
    92	
    93	def main():
    94	    ap = argparse.ArgumentParser()
    95	    ap.add_argument("--manifest_dir", default="benchmark/manifests_v2")
    96	    ap.add_argument("--domain", required=True, choices=list(DOMAIN_FILES))
    97	    ap.add_argument("--backend", default="qwen3")
    98	    ap.add_argument("--output", required=True)
    99	    ap.add_argument("--k", type=int, default=10, help="oracle queries per domain")
   100	    ap.add_argument("--fewshot_k", type=int, default=3)
   101	    ap.add_argument("--max_turns", type=int, default=4)
   102	    ap.add_argument("--max_workers", type=int, default=6)
   103	    ap.add_argument("--selection", choices=["random", "uncertainty"],
   104	                    default="uncertainty")
   105	    ap.add_argument("--skip_passive", action="store_true",
   106	                    help="Reuse existing passive result file if present.")
   107	    args = ap.parse_args()
   108	
   109	    manifest = json.load(open(os.path.join(args.manifest_dir,
   110	                                           DOMAIN_FILES[args.domain])))
   111	    dev_items = [x for x in manifest if x.get("split") == "dev"]
   112	    test_items = [x for x in manifest if x.get("split") == "test"]
   113	    print(f"[AL] domain={args.domain} dev={len(dev_items)} test={len(test_items)}",
   114	          flush=True)
   115	
   116	    client = get_client(args.backend)
   117	    model = get_model_name(args.backend)
   118	
   119	    # -------- Passive pass on TEST --------
   120	    passive_path = args.output.replace(".json", "_passive.json")
   121	    if args.skip_passive and os.path.exists(passive_path):
   122	        passive = json.load(open(passive_path))
   123	        print(f"[AL] reusing passive: {len(passive)} items", flush=True)
   124	    else:
   125	        def _passive(x):
   126	            try:
   127	                r = v9_mod.run_v9_item(client, model, x, "test",
   128	                                       args.max_turns)
   129	                return {"item_id": r.item_id, "score": r.score,
   130	                        "label_gt": x.get("label"),
   131	                        "domain_code": x.get("domain_code"),
   132	                        "rationale": r.rationale, "n_turns": r.n_turns,
   133	                        "error": r.error}
   134	            except Exception as e:
   135	                return {"item_id": x["item_id"], "score": 0.5,
   136	                        "label_gt": x.get("label"),
   137	                        "error": f"{type(e).__name__}: {e}"}
   138	        passive: list = []
   139	        t0 = time.time()
   140	        with ThreadPoolExecutor(max_workers=args.max_workers) as ex:
   141	            futs = [ex.submit(_passive, x) for x in test_items]
   142	            for i, f in enumerate(as_completed(futs)):
   143	                passive.append(f.result())
   144	                if (i + 1) % 20 == 0:
   145	                    print(f"[passive {args.domain}] {i+1}/{len(test_items)} "
   146	                          f"t={time.time()-t0:.0f}s", flush=True)
   147	        Path(passive_path).parent.mkdir(parents=True, exist_ok=True)
   148	        with open(passive_path, "w") as f:
   149	            json.dump(passive, f)
   150	
   151	    # -------- Select oracle queries from DEV --------
   152	    # First run agent on dev to get scores for uncertainty
   153	    print(f"[AL] running on dev ({len(dev_items)}) for selection", flush=True)
   154	
   155	    def _dev(x):
   156	        try:
   157	            r = v9_mod.run_v9_item(client, model, x, "dev", args.max_turns)
   158	            return {"item_id": r.item_id, "query_path": x["query_path"],
   159	                    "label": x.get("label"), "score": r.score,
   160	                    "rationale": r.rationale, "error": r.error}
   161	        except Exception as e:
   162	            return {"item_id": x["item_id"], "query_path": x["query_path"],
   163	                    "label": x.get("label"), "score": 0.5,
   164	                    "rationale": "", "error": f"{type(e).__name__}: {e}"}
   165	
   166	    dev_results = []
   167	    with ThreadPoolExecutor(max_workers=args.max_workers) as ex:
   168	        futs = [ex.submit(_dev, x) for x in dev_items]
   169	        for f in as_completed(futs):
   170	            dev_results.append(f.result())
   171	
   172	    if args.selection == "random":
   173	        import random
   174	        random.seed(42)
   175	        oracle = random.sample(dev_results, args.k)
   176	    else:
   177	        dev_results.sort(key=lambda d: abs((d.get("score") or 0.5) - 0.5))
   178	        oracle = dev_results[:args.k]
   179	
   180	    # Embed oracle pool
   181	    print(f"[AL] embedding {len(oracle)} oracle items", flush=True)
   182	    for d in oracle:
   183	        try:
   184	            d["embed"] = dinov2_embed(d["query_path"])
   185	        except Exception as e:
   186	            d["embed"] = None
   187	            d["embed_error"] = str(e)
   188	    oracle = [d for d in oracle if d.get("embed") is not None]
   189	
   190	    # -------- Active pass on TEST --------
   191	    print(f"[AL] running active pass on TEST with {len(oracle)} neighbors",
   192	          flush=True)
   193	    import numpy as np
   194	
   195	    def _active(x):
   196	        try:
   197	            ctx = build_fewshot_context(oracle, x["query_path"],
   198	                                        k=args.fewshot_k)
   199	            r = run_one(client, model, x, "test", args.max_turns, fewshot=ctx)
   200	            return {"item_id": r.item_id, "score": r.score,
   201	                    "label_gt": x.get("label"),
   202	                    "domain_code": x.get("domain_code"),
   203	                    "fewshot": [{"p": c["query_path"], "l": c["label"],
   204	                                 "s": c["similarity"]} for c in ctx],
   205	                    "rationale": r.rationale, "n_turns": r.n_turns,
   206	                    "error": r.error}
   207	        except Exception as e:
   208	            return {"item_id": x["item_id"], "score": 0.5,
   209	                    "label_gt": x.get("label"),
   210	                    "error": f"{type(e).__name__}: {e}"}
   211	
   212	    active: list = []
   213	    t0 = time.time()
   214	    with ThreadPoolExecutor(max_workers=args.max_workers) as ex:
   215	        futs = [ex.submit(_active, x) for x in test_items]
   216	        for i, f in enumerate(as_completed(futs)):
   217	            active.append(f.result())
   218	            if (i + 1) % 20 == 0:
   219	                print(f"[active {args.domain}] {i+1}/{len(test_items)} "
   220	                      f"t={time.time()-t0:.0f}s", flush=True)
   221	
   222	    # Drop embed arrays before dumping
   223	    oracle_out = [{k: v for k, v in d.items() if k != "embed"} for d in oracle]
   224	    out = {
   225	        "domain": args.domain,
   226	        "k": args.k,
   227	        "fewshot_k": args.fewshot_k,
   228	        "selection": args.selection,
   229	        "oracle_items": oracle_out,
   230	        "passive": passive,
   231	        "active": active,
   232	    }
   233	
   234	    # Compute AUROC
   235	    try:
   236	        from sklearn.metrics import roc_auc_score
   237	        passive_map = {r["item_id"]: r for r in passive}
