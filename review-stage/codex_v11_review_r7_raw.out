import json, os, math, statistics
from pathlib import Path

dirs = {
  'full':'benchmark/results/verbalized/v11_eval_test',
  'no':'benchmark/results/verbalized/v11_frozen_no_rules',
  'meta':'benchmark/results/verbalized/v11_frozen_meta_only',
  'shuf':'benchmark/results/verbalized/v11_frozen_shuffled',
}
keys=['item_id','label_gt','direct_score','v9_score','direct_rationale','rationale','v9_initial_score','v9_updated_score']
# Compare across all domains and all items by item_id.
all_ok=True
for dom in [f'D{i}' for i in range(1,13)]:
    rows={name:json.load(open(f'{d}/{dom}.json')) for name,d in dirs.items()}
    ids={name:[r['item_id'] for r in rows[name]] for name in rows}
    print(dom, {name:len(rows[name]) for name in rows}, 'same_order_no_meta_shuf', ids['no']==ids['meta']==ids['shuf'], 'same_order_full', ids['full']==ids['no'])
    if not (ids['no']==ids['meta']==ids['shuf']): all_ok=False
    by={name:{r['item_id']:r for r in rows[name]} for name in rows}
    mism=[]
    for iid in ids['no']:
        for k in keys:
            vals=[by[name][iid].get(k) for name in ['no','meta','shuf']]
            if not (vals[0]==vals[1]==vals[2]):
                mism.append((iid,k,vals[:3])); break
        if len(mism)>=3: break
    print('  frozen branch mismatches first3:', mism if mism else 'none')
    # compare full too for cached fields; full may have controller replay false but branch fields should match
    mism2=[]
    for iid in ids['no']:
        for k in keys:
            vals=[by[name][iid].get(k) for name in ['full','no','meta','shuf']]
            if not (vals[0]==vals[1]==vals[2]==vals[3]):
                mism2.append((iid,k,vals)); break
        if len(mism2)>=3: break
    print('  incl full mismatches first3:', mism2 if mism2 else 'none')

# Spot sample item rows across three frozen dirs for a few item ids in D4/D7/D9
for dom, idxs in [('D4',[0,20,80]),('D7',[0,40,90]),('D9',[0,60,100])]:
    print('\\nSAMPLES',dom)
    rows={name:json.load(open(f'{d}/{dom}.json')) for name,d in dirs.items() if name"'!='"'full'}
    for idx in idxs:
        iid=rows['no'][idx]['item_id']
        print(iid)
        for name in ['no','meta','shuf']:
            r=rows[name][idx]
            print(' ', name, 'label', r['label_gt'], 'v9', r['v9_score'], 'direct', r['direct_score'], 'final', r['anomaly_score'], 'trust', r.get('controller',{}).get('trust'))

def auc(y, s):
    n=len(y); pos=sum(y); neg=n-pos
    if pos==0 or neg==0: return float('nan')
    order=sorted(range(n), key=lambda i:s[i])
    ranks=[0]*n
    i=0; rank=1
    while i<n:
        j=i
        while j+1<n and s[order[j+1]]==s[order[i]]:
            j+=1
        avg=(rank + rank+(j-i))/2
        for k in range(i,j+1): ranks[order[k]]=avg
        rank += (j-i+1); i=j+1
    sum_pos=sum(ranks[i] for i,v in enumerate(y) if v==1)
    return (sum_pos - pos*(pos+1)/2)/(pos*neg)

def domain_metrics(path, dom):
    rows=json.load(open(f'{path}/{dom}.json'))
    y=[r['label_gt'] for r in rows]
    final=[r['anomaly_score'] for r in rows]
    blend=[0.5*r['v9_score']+0.5*r['direct_score'] for r in rows]
    return auc(y, blend), auc(y, final), len(rows), sum(y)
print('\\nDOMAIN AUCS:')
for dom in ['D4','D7','D8','D9','D3','D6','D11']:
    b, s, n, p = domain_metrics(dirs['shuf'], dom)
    b2, f, _, _=domain_metrics(dirs['full'], dom)
    print(dom, 'n',n,'pos',p,'blend',round(b,4),'shuf',round(s,4),'delta_shuf_pp',round((s-b)*100,2),'full_delta_pp',round((f-b2)*100,2))

# macro for all dirs
for name,path in dirs.items():
    vals=[]; blends=[]
    for dom in [f'D{i}' for i in range(1,13)]:
        b,s,_,_=domain_metrics(path,dom); vals.append(s); blends.append(b)
    print(name, 'macro final', sum(vals)/len(vals), 'macro blend', sum(blends)/len(blends), 'delta pp', (sum(vals)/12-sum(blends)/12)*100)
