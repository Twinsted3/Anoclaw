   359	def tool_side_by_side(query_path: str, bbox: list[int],
   360	                      ref_paths: list[str] | None = None, **_) -> dict:
   361	    """Composite: query_crop | ref0_crop | ref1_crop | ref2_crop | ref3_crop.
   362	
   363	    bbox is interpreted in 256x256 normalized coords (resize all images to 256).
   364	    """
   365	    if not isinstance(bbox, (list, tuple)) or len(bbox) != 4:
   366	        return {"error": "bbox must be [x0, y0, x1, y1]"}
   367	    x0, y0, x1, y1 = [int(v) for v in bbox]
   368	    if x1 <= x0 or y1 <= y0:
   369	        return {"error": f"invalid bbox {bbox}"}
   370	    if not ref_paths:
   371	        return {"error": "no ref_paths in session"}
   372	    def _crop(path):
   373	        img = Image.open(path).convert("RGB").resize((256, 256))
   374	        xa = max(0, min(255, x0)); ya = max(0, min(255, y0))
   375	        xb = max(xa + 1, min(256, x1)); yb = max(ya + 1, min(256, y1))
   376	        return img.crop((xa, ya, xb, yb)).resize((128, 128))
   377	    crops = [_crop(query_path)] + [_crop(p) for p in ref_paths[:4]]
   378	    total_w = 128 * len(crops)
   379	    composite = Image.new("RGB", (total_w, 128), (255, 255, 255))
   380	    for i, c in enumerate(crops):
   381	        composite.paste(c, (i * 128, 0))
   382	    out = {
   383	        "bbox": bbox,
   384	        "n_crops": len(crops),
   385	        "composite_b64": _pil_to_b64(composite, max_side=768),
   386	        "error": None,
