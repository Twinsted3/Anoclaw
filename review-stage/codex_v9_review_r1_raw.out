import json, math, os
from collections import defaultdict

def auc(y,s):
    y=list(map(int,y)); s=list(map(float,s)); n=len(y); n1=sum(y); n0=n-n1
    if n1==0 or n0==0: return None
    order=sorted(range(n), key=lambda i:s[i])
    ranks=[0]*n; i=0
    while i<n:
        j=i
        while j+1<n and s[order[j+1]]==s[order[i]]: j+=1
        avg=(i+1+j+1)/2
        for k in range(i,j+1): ranks[order[k]]=avg
        i=j+1
    rs=sum(r for r,yy in zip(ranks,y) if yy==1)
    return (rs - n1*(n1+1)/2)/(n1*n0)

manifest=json.load(open('benchmark/manifests/full_manifest.json'))
labels={x['item_id']:x['label'] for x in manifest}
domains={x['item_id']:x['domain_code'] for x in manifest}

def load(path):
    data=json.load(open(path))
    out=[]
    for r in data:
        iid=r.get('item_id')
        lab=r.get('label_gt')
        if lab is None and iid in labels: lab=labels[iid]
        dom=r.get('domain_code') or r.get('domain') or domains.get(iid)
        score=r.get('anomaly_score')
        if score is None: continue
        out.append((iid,dom,int(lab) if lab is not None else None,float(score),r))
    return out

def macro(path):
    rows=load(path)
    by=defaultdict(list)
    for iid,d,y,s,r in rows:
        if y is None: continue
        by[d].append((y,s))
    vals={d:auc([y for y,s in ys],[s for y,s in ys]) for d,ys in sorted(by.items())}
    vals={d:v for d,v in vals.items() if v is not None}
    return len(rows), sum(1 for x in rows if x[2] is not None), vals, sum(vals.values())/len(vals) if vals else None

def ens(path1,path2,w=0.5):
    a={iid:(d,y,s) for iid,d,y,s,r in load(path1) if y is not None}
    b={iid:(d,y,s) for iid,d,y,s,r in load(path2) if y is not None}
    ids=sorted(set(a)&set(b))
    by=defaultdict(list)
    for iid in ids:
        d,y,s1=a[iid]
        d2,y2,s2=b[iid]
        by[d].append((y,w*s1+(1-w)*s2))
    vals={d:auc([y for y,s in ys],[s for y,s in ys]) for d,ys in sorted(by.items())}
    vals={d:v for d,v in vals.items() if v is not None}
    return len(ids), vals, sum(vals.values())/len(vals) if vals else None

files=[
'benchmark/results/v6_direct_gpt_test.json',
'benchmark/results/v6_6_agent_gpt_test.json',
'benchmark/results/v6_7_agent_gpt_test.json',
'benchmark/results/v6_ensemble_v6_6_gpt_test.json',
'benchmark/results/v6_direct_seedvl_test.json',
'benchmark/results/v6_agent_seedvl_test.json',
'benchmark/results/v6_ensemble_seedvl_test.json',
'benchmark/results/v6_ensemble_v6_seedvl_test.json',
'benchmark/results/v6_direct_qwen3_test.json',
'benchmark/results/v6_5_agent_qwen3_test.json',
'benchmark/results/v6_ensemble_v6_5_qwen3_test.json',
'benchmark/results/anomaclaw_v4_qwen35_test.json',
'benchmark/results/v6_fusion_gpt_test.json',
'benchmark/results/v6_fusion_seedvl_test.json',
'benchmark/results/v6_fusion_qwen3_test.json']
for f in files:
    if not os.path.exists(f): continue
    n,nlab,vals,m=macro(f)
    print('\\n',os.path.basename(f),'n',n,'labels',nlab,'macro',None if m is None else round(m,6))
    print(' ', ' '.join(f'{d}:{v:.3f}' for d,v in vals.items()))

pairs=[('gpt v6_6','benchmark/results/v6_direct_gpt_test.json','benchmark/results/v6_6_agent_gpt_test.json',0.5),
       ('gpt v6_7partial','benchmark/results/v6_direct_gpt_test.json','benchmark/results/v6_7_agent_gpt_test.json',0.5),
       ('seed v6','benchmark/results/v6_direct_seedvl_test.json','benchmark/results/v6_agent_seedvl_test.json',0.5),
       ('qwen v6_5','benchmark/results/v6_direct_qwen3_test.json','benchmark/results/v6_5_agent_qwen3_test.json',0.5),
       ('qwen anomaclaw_v4','benchmark/results/v6_direct_qwen3_test.json','benchmark/results/anomaclaw_v4_qwen35_test.json',0.5)]
print('\\ncomputed ensembles')
for name,a,b,w in pairs:
    if not os.path.exists(a) or not os.path.exists(b): continue
    n,vals,m=ens(a,b,w)
    print('\\n',name,'ncommon',n,'macro',round(m,6))
    print(' ', ' '.join(f'{d}:{v:.3f}' for d,v in vals.items()))
