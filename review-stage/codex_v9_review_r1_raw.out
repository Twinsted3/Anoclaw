    86	def _parse_v9_action(text, mode_hint):
    87	    parsed = extract_json(text)
    88	    if not isinstance(parsed, dict):
    89	        return None
    90	    action = parsed.get("action")
    91	    if action not in ("call_tool", "final"):
    92	        return None
    93	    if action == "final":
    94	        # Required: anomaly_score or mcq_answer or free_text depending on mode
    95	        mode = parsed.get("mode") or mode_hint
    96	        # Always require anomaly_score (fallback sources)
    97	        score = parsed.get("anomaly_score")
    98	        if score is None:
    99	            score = parsed.get("score")  # backward-compat
   100	        if score is None:
   101	            score = (parsed.get("updated_score")
   102	                     or parsed.get("initial_score"))
   103	        if score is None:
   104	            score = 0.5
   105	        try:
   106	            parsed["anomaly_score"] = float(score)
   107	        except (TypeError, ValueError):
   108	            parsed["anomaly_score"] = 0.5
   109	
   110	        if mode in ("mcq_binary", "mcq_choice"):
   111	            letter = parsed.get("mcq_answer")
   112	            if letter not in ("A", "B", "C", "D"):
   113	                # Fallback 1: argmax of option_scores
   114	                if mode == "mcq_choice":
   115	                    opt = parsed.get("option_scores") or {}
   116	                    if opt:
   117	                        try:
   118	                            letter = max(opt.items(),
   119	                                         key=lambda kv: float(kv[1]))[0]
   120	                        except Exception:
   121	                            letter = None
   122	                # Fallback 2: regex parse of rationale / thought / free_text
   123	                if letter not in ("A", "B", "C", "D"):
   124	                    import re
   125	                    blob = " ".join(str(parsed.get(k, "")) for k in
   126	                                    ("rationale", "thought", "free_text"))
   127	                    m = re.search(r"\boption\s*([A-D])\b", blob,
   128	                                  re.IGNORECASE)
   129	                    if not m:
   130	                        m = re.search(r"\b(?:answer|choice)\s*(?:is|=)?\s*"
   131	                                      r"([A-D])\b", blob, re.IGNORECASE)
   132	                    if not m:
   133	                        m = re.search(r"\b([A-D])\)", blob)
   134	                    if m:
   135	                        letter = m.group(1).upper()
   136	                parsed["mcq_answer"] = (letter
   137	                                        if letter in ("A", "B", "C", "D")
   138	                                        else None)
   139	            else:
   140	                parsed["mcq_answer"] = letter
   141	        parsed["mode"] = mode
   142	    else:
   143	        if not parsed.get("tool"):
   144	            return None
   145	    return parsed

