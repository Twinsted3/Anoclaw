/bin/bash -lc "python - <<'PY'
import json, glob, collections
for p in sorted(glob.glob('benchmark/manifests_v2/*_manifest.json')):
    data=json.load(open(p));
    dom=collections.Counter(x.get('domain_code') for x in data)
    cats=collections.Counter(x.get('category') for x in data)
    splits=collections.Counter(x.get('split') for x in data)
    labels=collections.Counter(x.get('label') for x in data)
    print('\\n'+p)
    print(' domain', dom)
    print(' splits', splits, 'labels', labels)
    print(' n_categories', len(cats), 'sample', cats.most_common(10))
    print(' first', {k:data[0].get(k) for k in ['item_id','domain_code','domain_name','category','split','label','ref_paths','query_path']})
PY" in /hdd1/jiangxi/AD-Agent
