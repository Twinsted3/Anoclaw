import json
from pathlib import Path
pairs=[('benchmark/results/verbalized/v11_eval_test','full'),('benchmark/results/verbalized/v11_eval_test_meta_only','meta'),('benchmark/results/verbalized/v11_eval_test_no_rules','noR')]
full_dir=Path(pairs[0][0])
for other,label in pairs[1:]:
    other=Path(other)
    total=diff_v9=diff_direct=diff_any=0
    maxdv=maxda=0.0
    examples=[]
    for p in sorted(full_dir.glob('D*.json')):
        f={x['item_id']:x for x in json.load(open(p))}
        o={x['item_id']:x for x in json.load(open(other/p.name))}
        for item_id,x in f.items():
            y=o.get(item_id)
            if not y: continue
            total+=1
            dv=abs(float(x.get('direct_score',-999))-float(y.get('direct_score',-998)))
            da=abs(float(x.get('v9_score',-999))-float(y.get('v9_score',-998)))
            if dv>1e-9: diff_direct+=1; maxdv=max(maxdv,dv)
            if da>1e-9: diff_v9+=1; maxda=max(maxda,da)
            if dv>1e-9 or da>1e-9:
                diff_any+=1
                if len(examples)<5:
                    examples.append((item_id,x.get('direct_score'),y.get('direct_score'),x.get('v9_score'),y.get('v9_score')))
    print(label, 'total', total, 'diff_any', diff_any, 'diff_direct', diff_direct, 'diff_v9', diff_v9, 'max_direct_diff', maxdv, 'max_v9_diff', maxda)
    print('examples', examples[:5])
