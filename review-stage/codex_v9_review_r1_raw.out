   481	def tool_reference_retriever(query_path: str, domain_code: str | None = None,
   482	                             k: int = 4,
   483	                             index_dir: str = "/hdd1/jiangxi/AD-Agent/benchmark/retrieval_index",
   484	                             device: str = "cuda",
   485	                             item_id: str | None = None,
   486	                             _manifest_domain: str | None = None, **_) -> dict:
   487	    """Retrieve top-k most similar normal references via DINOv2 similarity.
   488	
   489	    `domain_code` may be provided by the agent; if not, we try `_manifest_domain`
   490	    (auto-injected from session ctx; this is the only place the agent legitimately
   491	    uses the domain code — to locate its cached normality bank, not for modeling).
   492	    """
   493	    domain_code = domain_code or _manifest_domain
   494	    if not domain_code:
   495	        return {"error": "domain_code required to locate retrieval index"}
   496	    idx_path = os.path.join(index_dir, f"{domain_code}_index.npz")
   497	    if not os.path.exists(idx_path):
   498	        return {"error": f"no retrieval index at {idx_path}"}
   499	    try:
   500	        import torch
   501	        model, transform = _load_retrieval_model_v6(device)
   502	        img = Image.open(query_path).convert("RGB")
   503	        tensor = transform(img).unsqueeze(0).to(device)
   504	        with torch.no_grad():
   505	            emb = model(tensor).cpu().numpy().flatten()
   506	        emb = emb / (np.linalg.norm(emb) + 1e-8)
   507	        data = np.load(idx_path, allow_pickle=True)
   508	        sims = data["embeddings"] @ emb
   509	        top_idx = np.argsort(sims)[::-1][:k]
   510	        results = [{"path": str(data["paths"][i]),
   511	                    "similarity": float(sims[i])} for i in top_idx]
   512	        out = {"results": results, "error": None,
   513	               "top_similarity": float(sims[top_idx[0]]) if len(top_idx) else 0.0}
   514	        verdict = (f"top-{k} most similar NORMAL refs retrieved "
   515	                   f"(top_similarity={out['top_similarity']:.3f})")
   516	        disconfirm = ("high top_similarity means the query matches a normal cluster "
   517	                      "well → likely NORMAL. Low similarity alone does NOT prove anomaly "
   518	                      "— the query may just be in a less-represented normal subtype")
   519	        return _wrap_interpretation(out, verdict, disconfirm)
   520	    except Exception as e:
   521	        return {"error": f"retrieval failed: {e}"}
