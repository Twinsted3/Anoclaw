     1	#!/bin/bash
     2	# Run active learning on all 12 domains sequentially.
     3	#
     4	# Usage: run_al_all_domains.sh [K]   # K = oracle queries per domain (default 10)
     5	
     6	set -e
     7	K=${1:-10}
     8	DOMAINS=${AL_DOMAINS:-"D1 D2 D3 D4 D5 D6 D7 D8 D9 D10 D11 D12"}
     9	
    10	export QWEN_API_BASE="http://localhost:8210/v1"
    11	export QWEN_MODEL="/hdd1/models/Qwen3.5-27B-FP8"
    12	
    13	cd /hdd1/jiangxi/AD-Agent
    14	mkdir -p benchmark/results/active_learning
    15	
    16	for D in $DOMAINS; do
    17	    OUT=benchmark/results/active_learning/al_qwen35_${D}.json
    18	    if [ -f "$OUT" ]; then
    19	        echo "[AL] $D output exists, skipping"
    20	        continue
    21	    fi
    22	    echo "=== [AL] $D starting at $(date +%H:%M:%S) ==="
    23	    /hdd1/jiangxi/AD-Agent/.venv_qwen35/bin/python \
    24	        benchmark/scripts/active_learning.py \
    25	        --manifest_dir benchmark/manifests_v2 \
    26	        --domain $D --output $OUT \
    27	        --k $K --fewshot_k 3 \
    28	        --max_turns 2 --max_workers 8 --backend qwen3 \
    29	        --max_test ${AL_MAX_TEST:-40} \
    30	        2>&1 | tee -a /tmp/al_${D}.log
    31	    echo "=== [AL] $D done at $(date +%H:%M:%S) ==="
    32	done
    33	
    34	echo "All domains complete."

