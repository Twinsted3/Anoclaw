import json, os
from collections import defaultdict

def auc(y,s):
    y=list(map(int,y)); s=list(map(float,s)); n=len(y); n1=sum(y); n0=n-n1
    if n1==0 or n0==0: return None
    order=sorted(range(n), key=lambda i:s[i]); ranks=[0]*n; i=0
    while i<n:
        j=i
        while j+1<n and s[order[j+1]]==s[order[i]]: j+=1
        avg=(i+1+j+1)/2
        for k in range(i,j+1): ranks[order[k]]=avg
        i=j+1
    return (sum(r for r,yy in zip(ranks,y) if yy)-n1*(n1+1)/2)/(n1*n0)
manifest=json.load(open('benchmark/manifests/full_manifest.json'))
labels={x['item_id']:x['label'] for x in manifest}; domains={x['item_id']:x['domain_code'] for x in manifest}
def load(path):
    data=json.load(open(path)); out=[]
    if isinstance(data,dict):
        for k in ['results','items','predictions']:
            if k in data: data=data[k]; break
    for r in data:
        iid=r.get('item_id'); y=r.get('label_gt')
        if y is None: y=r.get('label')
        if y is None and iid in labels: y=labels[iid]
        d=r.get('domain_code') or r.get('domain') or domains.get(iid)
        s=r.get('anomaly_score') if r.get('anomaly_score') is not None else r.get('score')
        if y is not None and s is not None: out.append((iid,d,int(y),float(s)))
    return out
def per(path):
    by=defaultdict(list)
    for iid,d,y,s in load(path): by[d].append((y,s))
    vals={d:auc([y for y,s in ys],[s for y,s in ys]) for d,ys in sorted(by.items())}
    vals={d:v for d,v in vals.items() if v is not None}
    return vals, sum(vals.values())/len(vals)
def ens(a,b,w=.5):
    A={iid:(d,y,s) for iid,d,y,s in load(a)}; B={iid:(d,y,s) for iid,d,y,s in load(b)}; by=defaultdict(list)
    for iid in sorted(set(A)&set(B)):
        d,y,s=A[iid]; d2,y2,t=B[iid]; by[d].append((y,w*s+(1-w)*t))
    vals={d:auc([y for y,s in ys],[s for y,s in ys]) for d,ys in sorted(by.items())}
    vals={d:v for d,v in vals.items() if v is not None}
    return vals, sum(vals.values())/len(vals)
for f in ['benchmark/results/seedvl_v0_direct_test_all_v2.json','benchmark/results/seedvl_agent_v1_test.json','benchmark/results/v6_agent_seedvl_test.json','benchmark/results/seedvl_v3_debate_1r_test_all_v2.json','benchmark/results/anomaclaw_v3_seedvl_test.json','benchmark/results/anomaclaw_v4_seedvl_test.json']:
    if os.path.exists(f):
        vals,m=per(f); print('\\n',os.path.basename(f),round(m,6)); print(' '.join(f'{d}:{v:.3f}' for d,v in vals.items()))
for b in ['benchmark/results/seedvl_agent_v1_test.json','benchmark/results/v6_agent_seedvl_test.json','benchmark/results/anomaclaw_v3_seedvl_test.json']:
