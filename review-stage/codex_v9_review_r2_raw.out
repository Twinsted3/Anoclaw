import json, collections, random
from sklearn.metrics import roc_auc_score
res=json.load(open('benchmark/results/mmad_anomaly_qwen3.json'))
mmad=json.load(open('MMAD/dataset/MMAD/mmad.json'))
def path_label(key):
    parent=key.split('/')[-2].lower() if '/' in key else ''
    return 0 if parent in {'good','normal','ok'} else 1
def opt_label(key, ans):
    v=mmad[key]
    # find AD conversation matching answer and type; for q0 usually item_id suffix q0
    for qa in v.get('conversation',[]):
        if qa.get('type')=='Anomaly Detection':
            opts=qa.get('Options') or {}
            a=qa.get('Answer')
            if a in opts:
                txt=str(opts[a]).lower()
                if any(k in txt for k in ('yes','defect','there is','anomal')): return 1
                if any(k in txt for k in ('no','normal')): return 0
    return path_label(key)
by=collections.defaultdict(list)
for r in res:
    key=r['item_id'].split('#',1)[0]
    r=dict(r)
    r['corrected_label']=opt_label(key,r['correct_answer'])
    by[r['dataset']].append(r)
all_labels=[]
print('corrected labels and metrics')
for name in ['DS-MVTec','MVTec-LOCO','VisA','GoodsAD','MVTec-AD']:
    sub=by[name]
    y=[r['corrected_label'] for r in sub]
    print(name,len(sub),'labels',collections.Counter(y))
    print(' acc', {f:round(sum(r[f]==r['correct_answer'] for r in sub)/len(sub)*100,1) for f in ['direct_answer','agent_answer','ensemble_answer']})
    if len(set(y))>1 and len(sub)>5:
        print(' auc', {f:round(roc_auc_score(y,[float(r[f]) for r in sub]),3) for f in ['direct_score','agent_score','ensemble_score']})
y=[r['corrected_label'] for r in res]
print('pooled labels',collections.Counter(y))
print('pooled auc', {f:roc_auc_score(y,[float(r[f]) for r in res]) for f in ['direct_score','agent_score','ensemble_score']})
# stratified by dataset paired bootstrap pooled AUROC delta seed 42
rng=random.Random(42)
deltas=[]
for _ in range(1000):
    sample=[]
    for sub in by.values():
        sample.extend(rng.choice(sub) for _ in range(len(sub)))
    y=[r['corrected_label'] for r in sample]
    d=roc_auc_score(y,[float(r['direct_score']) for r in sample])
    e=roc_auc_score(y,[float(r['ensemble_score']) for r in sample])
    deltas.append(e-d)
d=sorted(deltas)
print('boot',sum(d)/len(d),d[24],d[974],sum(x>0 for x in d)/len(d))
