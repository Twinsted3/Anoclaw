 'v66_g_test': 'benchmark/results/v6_6_agent_gpt_test.json',
 'v65_g_test': 'benchmark/results/v6_5_agent_gpt_test.json',
}
D={k:load(v) for k,v in paths.items() if Path(v).exists()}
for k,v in D.items():
 m,per=macro(v); scores=[float(r['anomaly_score']) for r in v.values()]
 mid=sum(0.2<=s<=0.8 for s in scores)/len(scores); low=sum(s<0.2 for s in scores)/len(scores); hi=sum(s>0.8 for s in scores)/len(scores)
 print(f'{k:14s} n={len(v):4d} macro={m:.4f} mid={mid:.1%} low={low:.1%} hi={hi:.1%}')
for name,a,b,w in [
 ('q 0.5d+0.5v65',D['direct_q'],D['v65_q'],0.5),
 ('q 0.6d+0.4v8',D['direct_q'],D['v8_q'],0.6),
 ('gdev 0.5d+0.5v66',D['direct_g_dev'],D['v66_g_dev'],0.5),
