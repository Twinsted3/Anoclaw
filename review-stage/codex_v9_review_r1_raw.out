 succeeded in 0ms:
     1	"""MMAD benchmark evaluator for AnomalyClaw on Qwen3.5-VL.
     2	
     3	MMAD is a 39,670-question industrial anomaly detection MCQ benchmark (Jiang
     4	et al., ICLR 2025). We evaluate on the "Anomaly Detection" subset
     5	(binary Yes/No per image; 8,297 images covering MVTec-AD, MVTec-LOCO,
     6	VisA, GoodsAD) by running Direct VLM and the v6 agent on each query,
     7	then mapping the anomaly score to A/B:
     8	
     9	    score > 0.5  ->  A ("Yes, there's a defect")
    10	    score <= 0.5 ->  B ("No defect")
    11	
    12	Per image we use the first 4 normal `random_templates` from mmad.json as
    13	references (consistent with MMAD protocol's few_shot=4 normal setup).
    14	
    15	Usage:
    16	    python benchmark/scripts/mmad_eval.py \
    17	      --mmad_root MMAD/dataset/MMAD \
    18	      --sample 1000 \
    19	      --output benchmark/results/mmad_anomaly_qwen3.json \
    20	      --max_workers 9 --max_turns 5
    21	"""
    22	from __future__ import annotations
    23	import argparse
    24	import json
    25	import os
    26	import random
    27	import sys
    28	import time
    29	from collections import Counter, defaultdict
    30	from concurrent.futures import ThreadPoolExecutor, as_completed
    31	from pathlib import Path
    32	
    33	sys.path.insert(0, str(Path(__file__).parent))
    34	
    35	from infer import (  # noqa: E402
    36	    call_llm, extract_json, get_client, get_model_name,
    37	    img_msg, load_and_encode, text_msg,
    38	)
    39	import agent_v6 as v6_mod  # noqa: E402
    40	
    41	
    42	def iter_mmad_ad_items(mmad_root: str, only_ad: bool = True):
    43	    """Yield one item per image × AD-question from mmad.json.
    44	
    45	    Each yielded dict:
    46	        item_id (str unique),
    47	        image (str absolute path),
    48	        refs (list of str absolute paths; first 4 random_templates),
    49	        class_name (e.g. "bottle"),
    50	        dataset (e.g. "DS-MVTec"),
    51	        label_gt (0 if 'good' in path, 1 otherwise),
    52	        correct_answer (str A|B|C|D),
    53	        question_type (str),
    54	        question (str),
    55	        options (dict).
    56	    """
    57	    mmad_json = json.load(open(os.path.join(mmad_root, "mmad.json")))
    58	    for key, v in mmad_json.items():
    59	        parts = key.split("/")
    60	        dataset = parts[0]
    61	        class_name = parts[1] if len(parts) >= 2 else "unknown"
    62	        image_abs = os.path.join(mmad_root, key)
    63	        refs = []
    64	        for t in (v.get("random_templates") or [])[:4]:
    65	            refs.append(os.path.join(mmad_root, t))
    66	        # Yield each QA turn
    67	        for idx, qa in enumerate(v.get("conversation", [])):
    68	            if only_ad and qa.get("type") != "Anomaly Detection":
    69	                continue
    70	            # Binary AD label: anomalous (label=1) unless path contains 'good' or 'normal'
    71	            label_gt = 0 if ("good" in key.lower() or "normal" in key.lower()) else 1
    72	            yield {
    73	                "item_id": f"{key}#q{idx}",
    74	                "image": image_abs,
    75	                "refs": refs,
    76	                "class_name": class_name,
    77	                "dataset": dataset,
    78	                "label_gt": label_gt,
    79	                "correct_answer": qa.get("Answer"),
    80	                "question_type": qa.get("type"),
    81	                "question": qa.get("Question"),
    82	                "options": qa.get("Options", {}),
    83	                "raw_key": key,
    84	            }
    85	
    86	
    87	def stratified_sample(items, n, seed=42):
    88	    """Sample n items stratified by class_name (roughly proportional)."""
    89	    rng = random.Random(seed)
    90	    by_class: dict[str, list] = defaultdict(list)
    91	    for x in items:
    92	        by_class[f"{x['dataset']}/{x['class_name']}"].append(x)
    93	    total = sum(len(v) for v in by_class.values())
    94	    # Proportional alloc with min 5 per class
    95	    alloc = {k: max(5, int(n * len(v) / total)) for k, v in by_class.items()}
    96	    total_alloc = sum(alloc.values())
    97	    if total_alloc > n:
    98	        # Scale down proportionally
    99	        scale = n / total_alloc
   100	        alloc = {k: max(3, int(v * scale)) for k, v in alloc.items()}
   101	    sample = []
   102	    for k, cap in alloc.items():
   103	        pool = by_class[k]
   104	        rng.shuffle(pool)
   105	        sample.extend(pool[:cap])
   106	    rng.shuffle(sample)
   107	    return sample
   108	
   109	
   110	# --- Direct VLM scoring -------------------------------------------------
   111	
   112	DIRECT_PROMPT = (
   113	    "You are a visual anomaly detection expert. I will show you four NORMAL "
   114	    "reference images of the same product, followed by one QUERY image. "
   115	    "Decide whether the query shows a manufacturing defect, damage, or "
   116	    "abnormal appearance.\n\n"
   117	    "Return ONLY a JSON object: {\"thought\": \"<one sentence>\", "
   118	    "\"score\": <float 0..1>, \"rationale\": \"<one sentence>\"}. "
   119	    "score close to 0 = clearly normal, score close to 1 = clearly anomalous, "
   120	    "0.5 = genuinely uncertain."
   121	)
   122	
   123	
   124	def direct_score(client, model, image_path: str, ref_paths: list[str]) -> dict:
   125	    parts = [text_msg("NORMAL REFERENCE IMAGES:")]
   126	    for rp in ref_paths[:4]:
   127	        if os.path.exists(rp):
   128	            parts.append(img_msg(load_and_encode(rp)))
   129	    parts.append(text_msg("QUERY IMAGE:"))
   130	    parts.append(img_msg(load_and_encode(image_path)))
   131	    messages = [
   132	        {"role": "system", "content": DIRECT_PROMPT},
   133	        {"role": "user", "content": parts},
   134	    ]
   135	    try:
   136	        text, _, _ = call_llm(client, model, messages,
   137	                              max_tokens=200, temperature=0.0)
   138	    except Exception as e:
   139	        return {"score": 0.5, "error": f"call_llm: {e}"}
   140	    parsed = extract_json(text)
   141	    if not isinstance(parsed, dict) or "score" not in parsed:
   142	        return {"score": 0.5, "error": "parse fail",
   143	                "raw": (text or "")[:200]}
   144	    try:
   145	        s = float(parsed["score"])
   146	        s = max(0.0, min(1.0, s))
   147	    except (TypeError, ValueError):
   148	        return {"score": 0.5, "error": "score not float"}
   149	    return {"score": s,
   150	            "thought": str(parsed.get("thought", ""))[:200],
   151	            "rationale": str(parsed.get("rationale", ""))[:200]}
   152	
   153	
   154	# --- v6 ReAct agent scoring ---------------------------------------------
   155	
   156	def v6_agent_score(agent: v6_mod.ReActAgent, item: dict, split: str = "test") -> dict:
   157	    """Run v6 agent and return score + rationale.
   158	
   159	    We pass a synthetic split and item_id so cached-expert tools won't
   160	    error (they'll just return missing-score errors that the agent learns
   161	    to ignore).
   162	    """
   163	    try:
   164	        r = agent.run(item_id=item["item_id"], query_path=item["image"],
   165	                      ref_paths=item["refs"], split=split,
   166	                      domain_code=None)
   167	        return {"score": r.score,
   168	                "n_turns": r.n_turns,
   169	                "tools_used": r.tools_used,
   170	                "rationale": (r.rationale or "")[:200],
   171	                "error": r.error}
   172	    except Exception as e:
   173	        return {"score": 0.5, "error": f"{type(e).__name__}: {e}"}
   174	
   175	
   176	def score_to_mcq(score: float, options: dict) -> str:
   177	    """Map score to MCQ answer. AD questions usually have A=Yes B=No."""
   178	    yes_letter = None
   179	    no_letter = None
   180	    for letter, text in options.items():
   181	        t = text.lower()
   182	        if "yes" in t or "there is" in t or "defect" in t:
   183	            yes_letter = letter
   184	        elif "no " in t or "no defect" in t or "not" in t:
   185	            no_letter = letter
   186	    yes_letter = yes_letter or "A"
   187	    no_letter = no_letter or "B"
   188	    return yes_letter if score > 0.5 else no_letter
   189	
   190	
   191	def main():
   192	    ap = argparse.ArgumentParser()
   193	    ap.add_argument("--mmad_root",
   194	                    default="MMAD/dataset/MMAD")
   195	    ap.add_argument("--output",
   196	                    default="benchmark/results/mmad_anomaly_qwen3.json")
   197	    ap.add_argument("--sample", type=int, default=1000,
   198	                    help="Stratified sample size (0 = all AD items)")
   199	    ap.add_argument("--backend", default="qwen3")
   200	    ap.add_argument("--max_workers", type=int, default=9)
   201	    ap.add_argument("--max_turns", type=int, default=5)
   202	    ap.add_argument("--seed", type=int, default=42)
   203	    ap.add_argument("--resume", action="store_true")
   204	    ap.add_argument("--mode", choices=["direct", "agent", "both"], default="both",
   205	                    help="direct only / agent only / both (for ensemble)")
   206	    args = ap.parse_args()
   207	
   208	    print(f"[mmad] loading from {args.mmad_root}/mmad.json ...", flush=True)
   209	    all_items = list(iter_mmad_ad_items(args.mmad_root, only_ad=True))
   210	    print(f"[mmad] {len(all_items)} Anomaly-Detection questions in full set", flush=True)
   211	
   212	    if args.sample and args.sample < len(all_items):
   213	        items = stratified_sample(all_items, args.sample, seed=args.seed)
   214	        print(f"[mmad] stratified sample -> {len(items)} items "
   215	              f"across {len({i['class_name'] for i in items})} classes", flush=True)
   216	    else:
   217	        items = all_items
   218	
   219	    # Resume logic
   220	    done_ids: set = set()
   221	    prev: list = []
   222	    if args.resume and os.path.exists(args.output):
   223	        prev = json.load(open(args.output))
   224	        done_ids = {r["item_id"] for r in prev if not r.get("error")}
   225	        items = [x for x in items if x["item_id"] not in done_ids]
   226	        print(f"[resume] {len(done_ids)} done; {len(items)} remaining", flush=True)
   227	
   228	    client = get_client(args.backend)
   229	    model = get_model_name(args.backend)
   230	    agent = v6_mod.ReActAgent(vlm_client=client, vlm_model=model,
   231	                              max_turns=args.max_turns)
   232	
   233	    t0 = time.time()
   234	
   235	    def _run(x):
   236	        out = {
   237	            "item_id": x["item_id"],
   238	            "image": x["raw_key"],  # MMAD key (relative)
   239	            "correct_answer": x["correct_answer"],
   240	            "question_type": x["question_type"],
   241	            "class_name": x["class_name"],
   242	            "dataset": x["dataset"],
   243	            "label_gt": x["label_gt"],
   244	        }
   245	        # Direct
   246	        if args.mode in ("direct", "both"):
   247	            dr = direct_score(client, model, x["image"], x["refs"])
   248	            out["direct_score"] = dr.get("score")
   249	            out["direct_rationale"] = dr.get("rationale", "")
   250	            if dr.get("error"):
   251	                out["direct_error"] = dr["error"]
   252	        # Agent
   253	        if args.mode in ("agent", "both"):
   254	            ag = v6_agent_score(agent, x, split="test")
   255	            out["agent_score"] = ag.get("score")
   256	            out["agent_n_turns"] = ag.get("n_turns")
   257	            out["agent_tools_used"] = ag.get("tools_used")
   258	            out["agent_rationale"] = ag.get("rationale", "")
   259	            if ag.get("error"):
   260	                out["agent_error"] = ag["error"]
   261	        # Ensemble
   262	        if args.mode == "both":
   263	            if out.get("direct_score") is not None and out.get("agent_score") is not None:
   264	                out["ensemble_score"] = 0.5 * out["direct_score"] + 0.5 * out["agent_score"]
   265	                out["ensemble_answer"] = score_to_mcq(out["ensemble_score"], x["options"])
   266	            out["direct_answer"] = score_to_mcq(out.get("direct_score", 0.5), x["options"])
   267	            out["agent_answer"] = score_to_mcq(out.get("agent_score", 0.5), x["options"])
   268	        elif args.mode == "direct":
   269	            out["direct_answer"] = score_to_mcq(out.get("direct_score", 0.5), x["options"])
   270	        else:
   271	            out["agent_answer"] = score_to_mcq(out.get("agent_score", 0.5), x["options"])
   272	        return out
   273	
   274	    Path(args.output).parent.mkdir(parents=True, exist_ok=True)
   275	    results = list(prev)
   276	    with ThreadPoolExecutor(max_workers=args.max_workers) as ex:
   277	        futs = [ex.submit(_run, x) for x in items]
   278	        for i, f in enumerate(as_completed(futs)):
   279	            try:
   280	                results.append(f.result())
   281	            except Exception as e:
   282	                print(f"[err] worker raised: {type(e).__name__}: {e}", flush=True)
   283	            if (i + 1) % 25 == 0:
   284	                with open(args.output, "w") as ff:
   285	                    json.dump(results, ff)
   286	                print(f"[{i+1}/{len(items)}] t={time.time()-t0:.1f}s", flush=True)
   287	
   288	    with open(args.output, "w") as f:
   289	        json.dump(results, f)
   290	    print(f"Wrote {len(results)} → {args.output}")
   291	
   292	    # Quick accuracy report
   293	    for field in ("direct_answer", "agent_answer", "ensemble_answer"):
   294	        correct = sum(1 for r in results if r.get(field) == r.get("correct_answer"))
   295	        total = sum(1 for r in results if r.get(field))
   296	        if total:
   297	            print(f"{field}: {correct}/{total} = {100*correct/total:.2f}%")
   298	
   299	
   300	if __name__ == "__main__":
   301	    main()

