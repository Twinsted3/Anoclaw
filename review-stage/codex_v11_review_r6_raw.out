/bin/bash -lc "python - <<'PY'
import json
from pathlib import Path
from sklearn.metrics import roc_auc_score
import numpy as np

def load(dirn):
    data={}
    for p in sorted(Path(dirn).glob('D*.json'), key=lambda p:int(p.stem[1:])):
        rows=[]
        for x in json.load(open(p)):
            if x.get('label_gt') is None or x.get('v9_score') is None or x.get('direct_score') is None: continue
            rows.append((int(x['label_gt']),0.5*float(x['v9_score'])+0.5*float(x['direct_score']),float(x.get('anomaly_score',0.5))))
        data[p.stem]=np.array(rows)
    return data

def boot(data,B=1000):
    rng=np.random.default_rng(0); dif=[]
    for _ in range(B):
        vals=[]
        for d,arr in data.items():
            idx=rng.integers(0,len(arr),len(arr)); sub=arr[idx]; y=sub[:,0].astype(int)
            if len(set(y))<2: continue
            vals.append(roc_auc_score(y,sub[:,2])-roc_auc_score(y,sub[:,1]))
        dif.append(np.mean(vals)*100)
    dif=np.array(dif); return dif.mean(), *np.percentile(dif,[2.5,97.5]), np.mean(dif>0)
for label,dirn in [('full','benchmark/results/verbalized/v11_eval_test'),('meta','benchmark/results/verbalized/v11_eval_test_meta_only'),('noR','benchmark/results/verbalized/v11_eval_test_no_rules')]:
    print(label, boot(load(dirn)))
