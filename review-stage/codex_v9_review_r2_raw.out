     1	"""Per-domain active self-evolution experiment.
     2	
     3	Protocol per domain:
     4	  1. Passive eval: run v9 agent on test items → baseline AUROC.
     5	  2. Oracle selection: from DEV split (not test), pick K items with
     6	     highest uncertainty (|agent_score - 0.5|) weighted by
     7	     agent/direct disagreement.
     8	  3. Oracle query: obtain GT labels for those K items (from manifest).
     9	  4. Build per-domain RAG keyed by DINOv2 CLS embedding of query image.
    10	  5. Active eval: re-run v9 on test items with top-3 labelled neighbors
    11	     injected as few-shot context in turn-1 user message.
    12	  6. Report per-domain AUROC Δ.
    13	
    14	Output: one JSON per domain with pre/post scores, plus combined summary.
    15	
    16	Usage:
    17	  python benchmark/scripts/active_learning.py \
    18	    --manifest_dir benchmark/manifests_v2 \
    19	    --domain D1 \
    20	    --output benchmark/results/al_q35_D1.json \
    21	    --k 10 --backend qwen3
    22	"""
    23	from __future__ import annotations
    24	import argparse
    25	import json
    26	import os
    27	import sys
    28	import time
    29	from concurrent.futures import ThreadPoolExecutor, as_completed
    30	from pathlib import Path
    31	
    32	sys.path.insert(0, str(Path(__file__).parent))
    33	
    34	import agent_v9 as v9_mod  # noqa: E402
    35	import agent_tools_v7 as _t7  # noqa: E402
    36	from infer import get_client, get_model_name  # noqa: E402
    37	
    38	
    39	DOMAIN_FILES = {
    40	    "D1": "D1_industrial_manifest.json",
    41	    "D2": "D2_retail_manifest.json",
    42	    "D3": "D3_complex_industrial_manifest.json",
    43	    "D4": "D4_infrastructure_manifest.json",
    44	    "D5": "D5_logical_manifest.json",
    45	    "D6": "D6_industrial_3d_manifest.json",
    46	    "D7": "D7_remote_sensing_manifest.json",
    47	    "D8": "D8_dermatology_manifest.json",
    48	    "D9": "D9_brain_mri_manifest.json",
    49	    "D10": "D10_liver_ct_manifest.json",
    50	    "D11": "D11_gi_endoscopy_manifest.json",
    51	    "D12": "D12_road_safety_manifest.json",
    52	}
    53	
    54	
    55	def dinov2_embed(image_path, device="cuda"):
    56	    """Return L2-normalised DINOv2 CLS embedding (384d)."""
    57	    from PIL import Image
    58	    import numpy as np
    59	    import torch
    60	    model, transform = _t7._load_retrieval_model_v6(device)
    61	    img = Image.open(image_path).convert("RGB")
    62	    t = transform(img).unsqueeze(0).to(device)
    63	    with torch.no_grad():
    64	        e = model(t).cpu().numpy().flatten()
    65	    return e / (np.linalg.norm(e) + 1e-8)
    66	
    67	
    68	def build_fewshot_context(oracle_pool, query_image, k=3):
    69	    """Retrieve top-k labelled neighbors by DINOv2 similarity.
    70	
    71	    oracle_pool: list of dicts {item_id, query_path, label, rationale}
    72	        each augmented with .embed (np.array 384).
    73	    Returns a list of dicts {query_path, label, rationale, similarity}.
    74	    """
    75	    import numpy as np
    76	    q_emb = dinov2_embed(query_image)
    77	    sims = np.array([float(q_emb @ x["embed"]) for x in oracle_pool])
    78	    if len(oracle_pool) == 0:
    79	        return []
    80	    top_idx = np.argsort(sims)[::-1][:k]
    81	    return [{"query_path": oracle_pool[i]["query_path"],
    82	             "label": oracle_pool[i]["label"],
    83	             "rationale": oracle_pool[i].get("rationale", ""),
    84	             "similarity": float(sims[i])} for i in top_idx]
    85	
    86	
    87	def run_one(client, model, item, split, max_turns, fewshot=None):
    88	    """Wrap v9 runner with optional fewshot injection (thread-safe via kwarg)."""
    89	    return v9_mod.run_v9_item(client, model, item, split, max_turns,
    90	                              fewshot_context=fewshot)
    91	
    92	
    93	def main():
    94	    ap = argparse.ArgumentParser()
    95	    ap.add_argument("--manifest_dir", default="benchmark/manifests_v2")
    96	    ap.add_argument("--domain", required=True, choices=list(DOMAIN_FILES))
    97	    ap.add_argument("--backend", default="qwen3")
    98	    ap.add_argument("--output", required=True)
    99	    ap.add_argument("--k", type=int, default=10, help="oracle queries per domain")
   100	    ap.add_argument("--fewshot_k", type=int, default=3)
   101	    ap.add_argument("--max_turns", type=int, default=4)
   102	    ap.add_argument("--max_workers", type=int, default=6)
   103	    ap.add_argument("--selection", choices=["random", "uncertainty"],
   104	                    default="uncertainty")
   105	    ap.add_argument("--skip_passive", action="store_true",
   106	                    help="Reuse existing passive result file if present.")
   107	    ap.add_argument("--max_test", type=int, default=0,
   108	                    help="Cap test items for quick pilot (0 = all).")
   109	    args = ap.parse_args()
   110	
   111	    manifest = json.load(open(os.path.join(args.manifest_dir,
   112	                                           DOMAIN_FILES[args.domain])))
   113	    dev_items = [x for x in manifest if x.get("split") == "dev"]
   114	    test_items = [x for x in manifest if x.get("split") == "test"]
   115	    if args.max_test > 0:
   116	        # Stratify roughly 50/50 normal/anomalous
   117	        normals = [x for x in test_items if x.get("label") == 0]
   118	        abnormals = [x for x in test_items if x.get("label") == 1]
   119	        half = args.max_test // 2
   120	        test_items = normals[:half] + abnormals[:args.max_test - half]
   121	    print(f"[AL] domain={args.domain} dev={len(dev_items)} test={len(test_items)}",
   122	          flush=True)
   123	
   124	    client = get_client(args.backend)
   125	    model = get_model_name(args.backend)
   126	
   127	    # -------- Passive pass on TEST --------
   128	    passive_path = args.output.replace(".json", "_passive.json")
   129	    if args.skip_passive and os.path.exists(passive_path):
   130	        passive = json.load(open(passive_path))
   131	        print(f"[AL] reusing passive: {len(passive)} items", flush=True)
   132	    else:
   133	        def _passive(x):
   134	            try:
   135	                r = v9_mod.run_v9_item(client, model, x, "test",
   136	                                       args.max_turns)
   137	                return {"item_id": r.item_id, "score": r.score,
   138	                        "label_gt": x.get("label"),
   139	                        "domain_code": x.get("domain_code"),
   140	                        "rationale": r.rationale, "n_turns": r.n_turns,
   141	                        "error": r.error}
   142	            except Exception as e:
   143	                return {"item_id": x["item_id"], "score": 0.5,
   144	                        "label_gt": x.get("label"),
   145	                        "error": f"{type(e).__name__}: {e}"}
   146	        passive: list = []
   147	        t0 = time.time()
   148	        with ThreadPoolExecutor(max_workers=args.max_workers) as ex:
   149	            futs = [ex.submit(_passive, x) for x in test_items]
   150	            for i, f in enumerate(as_completed(futs)):
   151	                passive.append(f.result())
   152	                if (i + 1) % 20 == 0:
   153	                    print(f"[passive {args.domain}] {i+1}/{len(test_items)} "
   154	                          f"t={time.time()-t0:.0f}s", flush=True)
   155	        Path(passive_path).parent.mkdir(parents=True, exist_ok=True)
   156	        with open(passive_path, "w") as f:
   157	            json.dump(passive, f)
   158	
   159	    # -------- Select oracle queries from DEV --------
   160	    # First run agent on dev to get scores for uncertainty
   161	    print(f"[AL] running on dev ({len(dev_items)}) for selection", flush=True)
   162	
   163	    def _dev(x):
   164	        try:
   165	            r = v9_mod.run_v9_item(client, model, x, "dev", args.max_turns)
   166	            return {"item_id": r.item_id, "query_path": x["query_path"],
   167	                    "label": x.get("label"), "score": r.score,
   168	                    "rationale": r.rationale, "error": r.error}
   169	        except Exception as e:
   170	            return {"item_id": x["item_id"], "query_path": x["query_path"],
   171	                    "label": x.get("label"), "score": 0.5,
   172	                    "rationale": "", "error": f"{type(e).__name__}: {e}"}
   173	
   174	    dev_results = []
   175	    with ThreadPoolExecutor(max_workers=args.max_workers) as ex:
   176	        futs = [ex.submit(_dev, x) for x in dev_items]
   177	        for f in as_completed(futs):
   178	            dev_results.append(f.result())
   179	
   180	    if args.selection == "random":
   181	        import random
   182	        random.seed(42)
   183	        oracle = random.sample(dev_results, args.k)
   184	    else:
   185	        dev_results.sort(key=lambda d: abs((d.get("score") or 0.5) - 0.5))
   186	        oracle = dev_results[:args.k]
   187	
   188	    # Embed oracle pool
   189	    print(f"[AL] embedding {len(oracle)} oracle items", flush=True)
   190	    for d in oracle:
   191	        try:
   192	            d["embed"] = dinov2_embed(d["query_path"])
   193	        except Exception as e:
   194	            d["embed"] = None
   195	            d["embed_error"] = str(e)
   196	    oracle = [d for d in oracle if d.get("embed") is not None]
   197	
   198	    # -------- Active pass on TEST --------
   199	    print(f"[AL] running active pass on TEST with {len(oracle)} neighbors",
   200	          flush=True)
   201	    import numpy as np
   202	
   203	    def _active(x):
   204	        try:
   205	            ctx = build_fewshot_context(oracle, x["query_path"],
   206	                                        k=args.fewshot_k)
   207	            r = run_one(client, model, x, "test", args.max_turns, fewshot=ctx)
   208	            return {"item_id": r.item_id, "score": r.score,
   209	                    "label_gt": x.get("label"),
   210	                    "domain_code": x.get("domain_code"),
   211	                    "fewshot": [{"p": c["query_path"], "l": c["label"],
   212	                                 "s": c["similarity"]} for c in ctx],
   213	                    "rationale": r.rationale, "n_turns": r.n_turns,
   214	                    "error": r.error}
   215	        except Exception as e:
   216	            return {"item_id": x["item_id"], "score": 0.5,
   217	                    "label_gt": x.get("label"),
   218	                    "error": f"{type(e).__name__}: {e}"}
   219	
   220	    active: list = []
   221	    t0 = time.time()
   222	    with ThreadPoolExecutor(max_workers=args.max_workers) as ex:
   223	        futs = [ex.submit(_active, x) for x in test_items]
   224	        for i, f in enumerate(as_completed(futs)):
   225	            active.append(f.result())
   226	            if (i + 1) % 20 == 0:
   227	                print(f"[active {args.domain}] {i+1}/{len(test_items)} "
   228	                      f"t={time.time()-t0:.0f}s", flush=True)
   229	
   230	    # Drop embed arrays before dumping
   231	    oracle_out = [{k: v for k, v in d.items() if k != "embed"} for d in oracle]
   232	    out = {
   233	        "domain": args.domain,
   234	        "k": args.k,
   235	        "fewshot_k": args.fewshot_k,
   236	        "selection": args.selection,
   237	        "oracle_items": oracle_out,
   238	        "passive": passive,
   239	        "active": active,
   240	    }
   241	
   242	    # Compute AUROC
   243	    try:
   244	        from sklearn.metrics import roc_auc_score
   245	        passive_map = {r["item_id"]: r for r in passive}
   246	        ids_with_label = [r["item_id"] for r in active
   247	                          if r.get("label_gt") is not None]
   248	        oracle_ids = {d["item_id"] for d in oracle}
   249	        # Exclude oracle items from eval (none should appear in test anyway,
   250	        # since oracle comes from dev)
   251	        hold = [r for r in active
   252	                if r["item_id"] not in oracle_ids
   253	                and r.get("label_gt") is not None]
   254	        y = [int(r["label_gt"]) for r in hold]
   255	        s_active = [float(r["score"]) for r in hold]
   256	        s_passive = [float(passive_map[r["item_id"]]["score"]) for r in hold
   257	                     if r["item_id"] in passive_map]
   258	        y_passive = [int(passive_map[r["item_id"]]["label_gt"]) for r in hold
   259	                     if r["item_id"] in passive_map]
   260	        out["auroc_active"] = float(roc_auc_score(y, s_active))
   261	        out["auroc_passive"] = float(roc_auc_score(y_passive, s_passive))
   262	        out["delta_auroc"] = out["auroc_active"] - out["auroc_passive"]
   263	        print(f"[AL {args.domain}] passive AUROC={out['auroc_passive']:.4f} "
   264	              f"active AUROC={out['auroc_active']:.4f} "
   265	              f"Δ={out['delta_auroc']:+.4f}", flush=True)
   266	    except Exception as e:
   267	        out["auroc_error"] = str(e)
   268	
   269	    Path(args.output).parent.mkdir(parents=True, exist_ok=True)
   270	    with open(args.output, "w") as f:
   271	        json.dump(out, f, default=str)
   272	    print(f"[AL] wrote {args.output}")
   273	
   274	
   275	if __name__ == "__main__":
   276	    main()

