/bin/bash -lc "python - <<'PY'
import json, glob, os
from sklearn.metrics import roc_auc_score
folders={
 'passive':'benchmark/results/verbalized/passive_test/*.json',
 'anchor':'benchmark/results/verbalized/v3_eval_anchor/*.json',
 'l1':'benchmark/results/verbalized/v3_eval_l1/*.json',
 'l2':'benchmark/results/verbalized/v3_eval_l2/*.json',
 'l1l2':'benchmark/results/verbalized/v3_eval_l1l2/*.json',
}
for name,pat in folders.items():
    vals=[]; total=0
    for fp in sorted(glob.glob(pat)):
        data=json.load(open(fp))
        y=[d.get('label',d.get('label_gt')) for d in data]
        s=[d.get('score',d.get('anomaly_score')) for d in data]
        auc=roc_auc_score(y,s)
        vals.append((os.path.basename(fp).split('_')[0],auc,len(data),sum(y)))
        total+=len(data)
    print(name, 'nfiles',len(vals),'n',total,'macro',sum(v[1] for v in vals)/len(vals))
    print(' ', ' '.join(f'{d}:{a:.3f}' for d,a,_,__ in vals))
