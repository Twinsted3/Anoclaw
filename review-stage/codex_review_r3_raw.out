     1	"""AnomalyClaw v8 — Dialectic (Competing Hypothesis Testing) agent.
     2	
     3	Wires agent_prompt_v8.SYSTEM_PROMPT into the v6 ReAct loop, with
     4	agent_tools_v7 (interpretation wrappers preserved).
     5	
     6	Captures the refutation schema (candidate_features, refutation_verdict,
     7	remaining_candidate_features, updated_score) plus full turn history
     8	into the output for downstream audit.
     9	"""
    10	from __future__ import annotations
    11	import argparse
    12	import json
    13	import os
    14	import sys
    15	import time
    16	from concurrent.futures import ThreadPoolExecutor, as_completed
    17	from dataclasses import dataclass
    18	from pathlib import Path
    19	
    20	sys.path.insert(0, str(Path(__file__).parent))
    21	
    22	import agent_prompt_v8 as _p8  # noqa: E402
    23	import agent_tools_v7 as _t7  # noqa: E402
    24	from infer import (  # noqa: E402
    25	    call_llm, extract_json, get_client, get_model_name,
    26	    img_msg, load_and_encode, text_msg,
    27	)
    28	
    29	
    30	@dataclass
    31	class V8Result:
    32	    item_id: str
    33	    score: float
    34	    rationale: str
    35	    n_turns: int
    36	    tools_used: list
    37	    history: list
    38	    initial_score: float | None
    39	    candidate_features: list | None
    40	    remaining_features: list | None
    41	    refutation_verdicts: list
    42	    updated_score: float | None
    43	    confidence: int
    44	    error: str | None = None
    45	
    46	
    47	def _build_initial_messages(query_path, ref_paths, max_turns):
    48	    user_parts = [
    49	        text_msg("NORMAL REFERENCE IMAGES:"),
    50	    ]
    51	    for rp in ref_paths[:4]:
    52	        user_parts.append(img_msg(load_and_encode(rp)))
    53	    user_parts.append(text_msg("QUERY IMAGE:"))
    54	    user_parts.append(img_msg(load_and_encode(query_path)))
    55	    user_parts.append(text_msg(
    56	        f"Turn 1/{max_turns}. Output initial_score, candidate_features "
    57	        f"(up to 3), refutation_target, then action."
    58	    ))
    59	    return [
    60	        {"role": "system", "content": _p8.SYSTEM_PROMPT},
    61	        {"role": "user", "content": user_parts},
    62	    ]
    63	
    64	
    65	def _parse_v8_action(text):
    66	    parsed = extract_json(text)
    67	    if not isinstance(parsed, dict):
    68	        return None
    69	    action = parsed.get("action")
    70	    if action not in ("call_tool", "final"):
    71	        return None
    72	    if action == "final":
    73	        score = parsed.get("score")
    74	        if score is None:
    75	            score = (parsed.get("updated_score")
    76	                     or parsed.get("initial_score"))
    77	        if score is None:
    78	            return None
    79	        try:
    80	            parsed["score"] = float(score)
    81	        except (TypeError, ValueError):
    82	            return None
    83	    else:
    84	        if not parsed.get("tool"):
    85	            return None
    86	    return parsed
    87	
    88	
    89	def _call_with_retry(client, model, messages, max_tokens=700, retries=1):
    90	    cur = list(messages)
    91	    for _ in range(1 + retries):
    92	        try:
    93	            text, _, _ = call_llm(client, model, cur,
    94	                                  max_tokens=max_tokens, temperature=0.0)
    95	        except Exception:
    96	            return None
    97	        parsed = _parse_v8_action(text)
    98	        if parsed is not None:
    99	            return parsed
   100	        cur = cur + [{
   101	            "role": "user",
   102	            "content": "Your last response was not valid JSON matching the "
   103	                       "schema. Return ONLY a JSON object with the required "
   104	                       "fields for this turn type."
   105	        }]
   106	    return None
   107	
   108	
   109	def _obs_to_text(obs):
   110	    """Compact text summary; put interpretation first so disconfirm is visible."""
   111	    small = {}
   112	    if "interpretation" in obs:
   113	        small["interpretation"] = obs["interpretation"]
   114	    for k, v in obs.items():
   115	        if k == "interpretation":
   116	            continue
   117	        if k.endswith("_b64"):
   118	            small[k] = f"<{len(v)}-char image>"
   119	        elif k == "tiles":
   120	            small[k] = f"<{len(v)} tiles attached>"
   121	        elif k == "top_patches":
   122	            small[k] = f"<{len(v)} patches>"
   123	        else:
   124	            small[k] = v
   125	    return json.dumps(small, default=str)[:1800]
   126	
   127	
   128	def _summarise_action(action):
   129	    """For message history — drop bulky args/stories."""
   130	    keep_keys = {"action", "tool", "thought", "initial_score",
   131	                 "candidate_features", "refutation_target",
   132	                 "refutation_verdict", "feature_status_update",
   133	                 "remaining_candidate_features", "updated_score",
   134	                 "evidence_strength", "confidence", "score"}
   135	    out = {k: v for k, v in action.items() if k in keep_keys and v is not None}
   136	    if "args" in action:
   137	        out["args"] = str(action["args"])[:300]
   138	    return out
   139	
   140	
   141	def run_v8_item(client, model, item, split, max_turns):
   142	    item_id = item["item_id"]
   143	    query_path = item["query_path"]
   144	    ref_paths = item["ref_paths"]
   145	    domain_code = item.get("domain_code")
   146	
   147	    ctx = {
   148	        "query_path": query_path,
   149	        "ref_paths": ref_paths,
   150	        "item_id": item_id,
   151	        "split": split,
   152	        "vlm_client": client,
   153	        "vlm_model": model,
   154	        "llm_client": client,
   155	        "llm_model": model,
   156	        "_manifest_domain": domain_code,
   157	    }
   158	
   159	    messages = _build_initial_messages(query_path, ref_paths, max_turns)
   160	    history = []
   161	    tools_used = []
   162	    initial_score = None
   163	    candidate_features = None
   164	    remaining_features = None
   165	    updated_score = None
   166	    refutation_verdicts: list = []
   167	
   168	    for turn in range(1, max_turns + 1):
   169	        action = _call_with_retry(client, model, messages)
   170	        if action is None:
   171	            return V8Result(
   172	                item_id=item_id, score=0.5, rationale="json parse failed",
   173	                n_turns=turn, tools_used=tools_used, history=history,
   174	                initial_score=initial_score, candidate_features=candidate_features,
   175	                remaining_features=remaining_features,
   176	                refutation_verdicts=refutation_verdicts,
   177	                updated_score=updated_score,
   178	                confidence=0, error="malformed JSON after retries",
   179	            )
   180	
   181	        # Capture turn-1 fields
   182	        if turn == 1:
   183	            initial_score = action.get("initial_score")
   184	            candidate_features = action.get("candidate_features")
   185	            remaining_features = candidate_features
   186	
   187	        # Capture refutation state
   188	        if action.get("refutation_verdict"):
   189	            refutation_verdicts.append({
   190	                "turn": turn,
   191	                "verdict": action.get("refutation_verdict"),
   192	                "status": action.get("feature_status_update"),
   193	            })
   194	        if action.get("remaining_candidate_features") is not None:
   195	            remaining_features = action.get("remaining_candidate_features")
   196	        if action.get("updated_score") is not None:
   197	            try:
   198	                updated_score = float(action["updated_score"])
   199	            except (TypeError, ValueError):
   200	                pass
   201	
   202	        if action["action"] == "final":
   203	            score = max(0.0, min(1.0, float(action["score"])))
   204	            return V8Result(
   205	                item_id=item_id, score=score,
   206	                rationale=str(action.get("rationale", ""))[:500],
   207	                n_turns=turn, tools_used=tools_used,
   208	                history=history + [{"turn": turn, **_summarise_action(action)}],
   209	                initial_score=initial_score, candidate_features=candidate_features,
   210	                remaining_features=remaining_features,
   211	                refutation_verdicts=refutation_verdicts,
   212	                updated_score=updated_score,
   213	                confidence=int(action.get("confidence", 0) or 0),
   214	            )
   215	
   216	        # Budget exhausted: force final
   217	        if turn == max_turns:
   218	            messages.append({"role": "assistant",
   219	                             "content": json.dumps(_summarise_action(action))})
   220	            messages.append({"role": "user",
   221	                             "content": _p8.forced_final_prompt(max_turns)})
   222	            forced = _call_with_retry(client, model, messages)
   223	            if forced and forced.get("action") == "final":
   224	                score = max(0.0, min(1.0, float(forced["score"])))
   225	                return V8Result(
   226	                    item_id=item_id, score=score,
   227	                    rationale=str(forced.get("rationale", ""))[:500],
   228	                    n_turns=max_turns, tools_used=tools_used,
   229	                    history=history + [
   230	                        {"turn": turn, **_summarise_action(action)},
   231	                        {"turn": turn, **_summarise_action(forced)},
   232	                    ],
   233	                    initial_score=initial_score, candidate_features=candidate_features,
   234	                    remaining_features=remaining_features,
   235	                    refutation_verdicts=refutation_verdicts,
   236	                    updated_score=updated_score,
   237	                    confidence=int(forced.get("confidence", 0) or 0),
   238	                )
   239	            return V8Result(
   240	                item_id=item_id, score=0.5, rationale="forced-final failed",
   241	                n_turns=max_turns, tools_used=tools_used, history=history,
   242	                initial_score=initial_score, candidate_features=candidate_features,
   243	                remaining_features=remaining_features,
   244	                refutation_verdicts=refutation_verdicts,
   245	                updated_score=updated_score,
   246	                confidence=0, error="forced-final produced non-final",
   247	            )
   248	
   249	        # Execute tool
   250	        tool_name = action["tool"]
   251	        tool_args = action.get("args") or {}
   252	        observation = _t7.dispatch_tool(tool_name, tool_args, ctx)
   253	        tools_used.append(tool_name)
   254	        history.append({"turn": turn, **_summarise_action(action),
   255	                        "obs_keys": list(observation.keys()),
   256	                        "obs_error": observation.get("error")})
   257	
   258	        if tool_name == "tool_expert_score":
   259	            ctx["_expert_patches"] = observation.get("top_patches", [])
   260	
   261	        obs_parts = []
   262	        obs_parts.append(text_msg(
   263	            f"OBSERVATION from {tool_name}: {_obs_to_text(observation)}"))
   264	        for img_key in ("crop_b64", "diff_mask_b64", "aligned_diff_b64",
   265	                        "composite_b64"):
   266	            if observation.get(img_key):
   267	                obs_parts.append(img_msg(observation[img_key]))
   268	        if observation.get("tiles"):
   269	            for t in observation["tiles"][:9]:
   270	                obs_parts.append(img_msg(t["crop_b64"]))
   271	        remaining = max_turns - turn
   272	        obs_parts.append(text_msg(
   273	            f"Turn {turn + 1}/{max_turns}. "
   274	            f"{_p8.budget_warning_prompt(remaining)}\n"
   275	            f"Refute the current refutation_target against this evidence. "
   276	            f"Update remaining_candidate_features and updated_score. "
   277	            f"Continue or finalise."))
   278	        messages.append({"role": "assistant",
   279	                         "content": json.dumps(_summarise_action(action))})
   280	        messages.append({"role": "user", "content": obs_parts})
   281	
   282	    return V8Result(
   283	        item_id=item_id, score=0.5, rationale="loop exhausted",
   284	        n_turns=max_turns, tools_used=tools_used, history=history,
   285	        initial_score=initial_score, candidate_features=candidate_features,
   286	        remaining_features=remaining_features,
   287	        refutation_verdicts=refutation_verdicts,
   288	        updated_score=updated_score,
   289	        confidence=0, error="loop exhausted without final",
   290	    )
   291	
   292	
   293	def main():
   294	    ap = argparse.ArgumentParser()
   295	    ap.add_argument("--manifest", required=True)
   296	    ap.add_argument("--split", choices=["calibration", "dev", "test"], required=True)
   297	    ap.add_argument("--backend", choices=["gpt", "seedvl", "qwen3"], required=True)
   298	    ap.add_argument("--output", required=True)
   299	    ap.add_argument("--max_turns", type=int, default=5)
   300	    ap.add_argument("--max_workers", type=int, default=9)
   301	    ap.add_argument("--max_items", type=int, default=0)
   302	    ap.add_argument("--resume", action="store_true")
   303	    args = ap.parse_args()
   304	
   305	    items = json.load(open(args.manifest))
   306	    items = [x for x in items if x.get("split") == args.split]
   307	    if args.max_items:
   308	        items = items[:args.max_items]
   309	
   310	    prev = []
   311	    done_ids = set()
   312	    if args.resume and os.path.exists(args.output):
   313	        prev = json.load(open(args.output))
   314	        done_ids = {r["item_id"] for r in prev if r.get("error") is None}
   315	        items = [x for x in items if x["item_id"] not in done_ids]
   316	        print(f"[resume] {len(done_ids)} done; {len(items)} remaining")
   317	
   318	    client = get_client(args.backend)
   319	    model = get_model_name(args.backend)
   320	
   321	    results = list(prev)
   322	    t0 = time.time()
   323	
   324	    def _run(x):
   325	        try:
   326	            r = run_v8_item(client, model, x, args.split, args.max_turns)
   327	            return {
   328	                "item_id": r.item_id, "domain_code": x.get("domain_code"),
   329	                "label_gt": x.get("label"), "anomaly_score": r.score,
   330	                "rationale": r.rationale, "n_turns": r.n_turns,
   331	                "tools_used": r.tools_used, "confidence": r.confidence,
   332	                "initial_score": r.initial_score,
   333	                "candidate_features": r.candidate_features,
   334	                "remaining_features": r.remaining_features,
   335	                "refutation_verdicts": r.refutation_verdicts,
   336	                "updated_score": r.updated_score,
   337	                "history": r.history,  # codex r1 feedback: expose full trace
   338	                "error": r.error,
   339	            }
   340	        except Exception as e:
   341	            return {"item_id": x["item_id"], "domain_code": x.get("domain_code"),
   342	                    "label_gt": x.get("label"), "anomaly_score": 0.5,
   343	                    "n_turns": 0, "tools_used": [], "confidence": 0,
   344	                    "error": f"{type(e).__name__}: {e}"}
   345	
   346	    Path(args.output).parent.mkdir(parents=True, exist_ok=True)
   347	    with ThreadPoolExecutor(max_workers=args.max_workers) as ex:
   348	        futs = [ex.submit(_run, x) for x in items]
   349	        for i, f in enumerate(as_completed(futs)):
   350	            results.append(f.result())
   351	            if (i+1) % 25 == 0:
   352	                with open(args.output, "w") as ff:
   353	                    json.dump(results, ff)
   354	                print(f"[{i+1}/{len(items)}] t={time.time()-t0:.1f}s", flush=True)
   355	
   356	    with open(args.output, "w") as f:
   357	        json.dump(results, f)
   358	    print(f"Wrote {len(results)} → {args.output}")
   359	
   360	

