    50	def _build_initial_messages(query_path, ref_paths, question, options,
    51	                            max_turns, fewshot_context=None, rulebook=None):
    52	    # Pre-classify mode so we can drop refs for `object_analysis` — the
    53	    # classifier reads only (question, options) text, never dataset
    54	    # metadata.
    55	    preamble = _p9.format_task_preamble(question, options)
    56	    skip_refs = (preamble.get("mode_hint") in ("mcq_choice_object",
    57	                                               "object_analysis"))
    58	
    59	    user_parts = []
    60	    if ref_paths and not skip_refs:
    61	        user_parts.append(text_msg("NORMAL REFERENCE IMAGES:"))
    62	        for rp in ref_paths[:4]:
    63	            user_parts.append(img_msg(load_and_encode(rp)))
    64	    user_parts.append(text_msg("QUERY IMAGE:"))
    65	    user_parts.append(img_msg(load_and_encode(query_path)))
    66	    preamble_text = preamble["text"]
    67	    if rulebook:
    68	        # Verbalized Self-Evolution rulebook (§5). Prepended to the task
    69	        # preamble so the agent consults the rulebook BEFORE deciding on
    70	        # its mode and its candidate features.
    71	        preamble_text = rulebook.rstrip() + "\n\n" + preamble_text
    72	    if fewshot_context:
    73	        # Compact injection — no rationale, no similarity — to avoid
    74	        # confusing the strict JSON schema of the refutation prompt.
    75	        n_anom = sum(1 for f in fewshot_context if f.get("label") == 1)
    76	        n_norm = len(fewshot_context) - n_anom
    77	        preamble_text = (
    78	            preamble_text
    79	            + f"\n\nDomain prior (from {len(fewshot_context)} recent"
    80	              f" labelled neighbours of this query): {n_anom} were"
    81	              f" ANOMALOUS, {n_norm} were NORMAL. Use this as a weak prior"
    82	              f" on what an anomaly in this domain typically looks like."
    83	        )
    84	    user_parts.append(text_msg(preamble_text))
    85	    user_parts.append(text_msg(
    86	        f"Turn 1/{max_turns}. Produce the turn-1 JSON for this mode. "
    87	        f"mode='{preamble['mode_hint']}' (you may override if confident)."
    88	    ))
    89	    return [
    90	        {"role": "system", "content": _p9.SYSTEM_PROMPT},
   390	        obs_parts.append(text_msg(
   391	            f"Turn {turn + 1}/{max_turns}. "
   392	            f"{_p9.budget_warning_prompt(remaining)}\n"
   393	            f"Incorporate this evidence, update your fields, continue or "
   394	            f"finalise."))
   395	        messages.append({"role": "assistant",
   396	                         "content": json.dumps(_summarise_action(action))})
   397	        messages.append({"role": "user", "content": obs_parts})
   398	
   399	    return V9Result(
   400	        item_id=item_id, mode=mode_hint, score=0.5,
   401	        mcq_answer=None, free_text=None, option_scores=None,
   402	        rationale="loop exhausted",
   403	        n_turns=max_turns, tools_used=tools_used, history=history,
   404	        initial_score=initial_score, candidate_features=candidate_features,
   405	        remaining_features=remaining_features,
   406	        refutation_verdicts=refutation_verdicts,
   407	        updated_score=updated_score,
   408	        confidence=0, error="loop exhausted without final",
   409	    )
   410	
   411	
   412	def main():
   413	    """CLI for regression-testing v9 on CrossDomainVAD manifests (no MCQ)."""
   414	    ap = argparse.ArgumentParser()
   415	    ap.add_argument("--manifest", required=True)
   416	    ap.add_argument("--split", choices=["calibration", "dev", "test"],
   417	                    required=True)
   418	    ap.add_argument("--backend", choices=["gpt", "seedvl", "qwen3"],
   419	                    required=True)
   420	    ap.add_argument("--output", required=True)
   421	    ap.add_argument("--max_turns", type=int, default=5)
   422	    ap.add_argument("--max_workers", type=int, default=9)
   423	    ap.add_argument("--max_items", type=int, default=0)
   424	    ap.add_argument("--resume", action="store_true")
   425	    args = ap.parse_args()
   426	
   427	    items = json.load(open(args.manifest))
   428	    items = [x for x in items if x.get("split") == args.split]
   429	    if args.max_items:
   430	        items = items[:args.max_items]
   431	
   432	    prev = []
   433	    done_ids = set()
   434	    if args.resume and os.path.exists(args.output):
   435	        prev = json.load(open(args.output))
   436	        done_ids = {r["item_id"] for r in prev if r.get("error") is None}
   437	        items = [x for x in items if x["item_id"] not in done_ids]
   438	
   439	    client = get_client(args.backend)
   440	    model = get_model_name(args.backend)
   441	
   442	    def _run(x):
   443	        try:
   444	            r = run_v9_item(client, model, x, args.split, args.max_turns)
   445	            return {
   446	                "item_id": r.item_id, "domain_code": x.get("domain_code"),
   447	                "label_gt": x.get("label"), "mode": r.mode,
   448	                "anomaly_score": r.score,
   449	                "rationale": r.rationale, "n_turns": r.n_turns,
   450	                "tools_used": r.tools_used, "confidence": r.confidence,
   451	                "initial_score": r.initial_score,
   452	                "candidate_features": r.candidate_features,
   453	                "remaining_features": r.remaining_features,
   454	                "refutation_verdicts": r.refutation_verdicts,
   455	                "updated_score": r.updated_score,
   456	                "history": r.history,
   457	                "error": r.error,
   458	            }
   459	        except Exception as e:
   460	            return {"item_id": x["item_id"], "anomaly_score": 0.5,
   461	                    "error": f"{type(e).__name__}: {e}"}
   462	
   463	    results = list(prev)
   464	    t0 = time.time()
   465	    Path(args.output).parent.mkdir(parents=True, exist_ok=True)
   466	    with ThreadPoolExecutor(max_workers=args.max_workers) as ex:
   467	        futs = [ex.submit(_run, x) for x in items]
   468	        for i, f in enumerate(as_completed(futs)):
   469	            results.append(f.result())
   470	            if (i + 1) % 25 == 0:
   471	                with open(args.output, "w") as ff:
   472	                    json.dump(results, ff)
   473	                print(f"[{i+1}/{len(items)}] t={time.time()-t0:.1f}s",
   474	                      flush=True)
   475	
   476	    with open(args.output, "w") as f:
   477	        json.dump(results, f)
   478	    print(f"Wrote {len(results)} → {args.output}")
   479	
   480	
   481	if __name__ == "__main__":
   482	    main()

