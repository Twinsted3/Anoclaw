/bin/bash -lc "python - <<'PY'
import json, collections, statistics
from pathlib import Path
for p in ['benchmark/results/v8_qwen3_dev.json','benchmark/results/v8_qwen3_test.json','benchmark/results/v8_agent_gpt_dev.json']:
    data=json.load(open(p))
    n=len(data)
    errs=sum(bool(x.get('error')) for x in data)
    tools=sum(1 for x in data if x.get('tools_used'))
    turns=[x.get('n_turns') or 0 for x in data]
    cand_empty=sum(1 for x in data if not x.get('candidate_features'))
    verdicts=sum(len(x.get('refutation_verdicts') or []) for x in data)
    items_with_verdict=sum(1 for x in data if x.get('refutation_verdicts'))
    scores=[x.get('anomaly_score') for x in data if isinstance(x.get('anomaly_score'), (int,float))]
    mid=sum(0.2 <= s <= 0.8 for s in scores)
    low=sum(s<0.2 for s in scores); high=sum(s>0.8 for s in scores)
    print('\\n',p)
    print('n',n,'errs',errs, f'{errs/n:.1%}', 'used_tool',tools, f'{tools/n:.1%}', 'cand_empty', cand_empty, f'{cand_empty/n:.1%}')
    print('avg turns', sum(turns)/n, 'turn counts', dict(sorted(collections.Counter(turns).items())))
    print('items_with_verdict', items_with_verdict, f'{items_with_verdict/n:.1%}', 'total verdicts', verdicts)
    print('score bins low/mid/high', low, mid, high, f'mid={mid/n:.1%}')
    print('top tools', collections.Counter(t for x in data for t in (x.get('tools_used') or [])).most_common())
    print('verdict counts', collections.Counter(v.get('verdict') for x in data for v in (x.get('refutation_verdicts') or [])).most_common())
PY" in /hdd1/jiangxi/AD-Agent
