import json, collections, math, random
from sklearn.metrics import roc_auc_score
f='benchmark/results/mmad_anomaly_qwen3.json'
data=json.load(open(f))
print('n',len(data),'keys',sorted(data[0].keys()))
by=collections.defaultdict(list)
for r in data: by[r['dataset']].append(r)
for name in sorted(by):
    sub=by[name]
    labels=[int(r['label_gt']) for r in sub]
    print('\\n',name,len(sub),'labels',collections.Counter(labels))
    corr={field:sum(r.get(field)==r.get('correct_answer') for r in sub)/len(sub)*100 for field in ['direct_answer','agent_answer','ensemble_answer']}
    print('acc', {k:round(v,1) for k,v in corr.items()})
    if len(set(labels))>1 and len(sub)>5:
        print('auc', {field:round(roc_auc_score(labels,[float(r[field]) for r in sub]),3) for field in ['direct_score','agent_score','ensemble_score']})
labels=[int(r['label_gt']) for r in data]
print('\\npooled labels',collections.Counter(labels))
print('pooled acc', {field:round(sum(r.get(field)==r.get('correct_answer') for r in data)/len(data)*100,1) for field in ['direct_answer','agent_answer','ensemble_answer']})
print('pooled auc', {field:roc_auc_score(labels,[float(r[field]) for r in data]) for field in ['direct_score','agent_score','ensemble_score']})
# simple paired stratified bootstrap by dataset for ensemble-direct delta, macro? pooled roc over sample? use pooled over resampled within dataset
rng=random.Random(0)
deltas=[]
for _ in range(1000):
    sample=[]
    for sub in by.values():
        sample.extend(rng.choice(sub) for _ in range(len(sub)))
    y=[int(r['label_gt']) for r in sample]
    if len(set(y))<2: continue
    dd=roc_auc_score(y,[float(r['direct_score']) for r in sample])
    ee=roc_auc_score(y,[float(r['ensemble_score']) for r in sample])
    deltas.append(ee-dd)
deltas=sorted(deltas)
print('bootstrap seed0 pooled delta mean/ci/p>',sum(deltas)/len(deltas),deltas[24],deltas[974],sum(d>0 for d in deltas)/len(deltas))
