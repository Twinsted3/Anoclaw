import json, collections, random
from sklearn.metrics import roc_auc_score
res0=json.load(open('benchmark/results/mmad_anomaly_qwen3.json'))
mmad=json.load(open('MMAD/dataset/MMAD/mmad.json'))
def path_label(key):
    parent=key.split('/')[-2].lower() if '/' in key else ''
    return 0 if parent in {'good','normal','ok'} else 1
def opt_label(key):
    v=mmad[key]
    for qa in v.get('conversation',[]):
        if qa.get('type')=='Anomaly Detection':
            a=qa.get('Answer'); opts=qa.get('Options') or {}
            if a in opts:
                txt=str(opts[a]).lower()
                if any(k in txt for k in ('yes','defect','there is','anomal')): return 1
                if any(k in txt for k in ('no','normal')): return 0
    return path_label(key)
res=[]
for r0 in res0:
    r=dict(r0)
    key=r['item_id'].split('#',1)[0]
    r['corrected_label']=opt_label(key)
    res.append(r)
by=collections.defaultdict(list)
for r in res: by[r['dataset']].append(r)
y=[r['corrected_label'] for r in res]
print('pooled labels',collections.Counter(y))
print('pooled auc', {f:roc_auc_score(y,[float(r[f]) for r in res]) for f in ['direct_score','agent_score','ensemble_score']})
for name, sub in sorted(by.items()):
    y2=[r['corrected_label'] for r in sub]
    if len(set(y2))>1:
        print(name, {f:roc_auc_score(y2,[float(r[f]) for r in sub]) for f in ['direct_score','agent_score','ensemble_score']})
# bootstrap stratified by dataset, skip if sample one class not issue pooled
for seed in [0,42,123]:
 rng=random.Random(seed); deltas=[]
 for _ in range(1000):
    sample=[]
    for sub in by.values(): sample.extend(rng.choice(sub) for _ in range(len(sub)))
    yy=[r['corrected_label'] for r in sample]
    deltas.append(roc_auc_score(yy,[float(r['ensemble_score']) for r in sample])-roc_auc_score(yy,[float(r['direct_score']) for r in sample]))
 d=sorted(deltas)
 print('seed',seed,'mean',sum(d)/len(d),'ci',d[24],d[974],'p',sum(x>0 for x in d)/len(d))
