import json, math, collections
from pathlib import Path
try:
 from sklearn.metrics import roc_auc_score
except Exception as e:
 print('sklearn missing', e); raise

def load(p):
 data=json.load(open(p)); return {x['item_id']:x for x in data if x.get('label_gt') is not None and x.get('anomaly_score') is not None}
def macro(byid):
 dom=collections.defaultdict(list)
 for r in byid.values(): dom[r['domain_code']].append(r)
 vals={}
 for d,rs in sorted(dom.items()):
  y=[int(r['label_gt']) for r in rs]
  s=[float(r['anomaly_score']) for r in rs]
  if len(set(y))<2: continue
  vals[d]=roc_auc_score(y,s)
 return sum(vals.values())/len(vals), vals

def blend(a,b,wa=0.5):
 ids=set(a)&set(b)
 out={}
 for i in ids:
  r=dict(a[i]); r['anomaly_score']=wa*float(a[i]['anomaly_score'])+(1-wa)*float(b[i]['anomaly_score']); out[i]=r
 return out
